<form method="post" action="@Action" data-enhance="false">
    <AntiforgeryToken />

    <div class="mb-3">
        <label class="form-label fw-semibold small text-dark ms-2" for="name">
            <i class="bi bi-person-fill me-1 text-muted"></i> @(Admin ? "Tên người quản trị" : "Tên đại lý") <span class="text-danger">*</span>
        </label>
        <input id="name" name="name"
               class="form-control form-control-lg rounded-pill px-4 shadow-none"
               style="border-radius: 50px !important; font-size: 0.95rem; border: 1.5px solid #dce2e6;"
               placeholder="@(Admin ? "Họ và tên quản trị viên" : "Tên đại lý / Doanh nghiệp")"
               required minlength="2" maxlength="150"
               autocomplete="organization" />
    </div>

    <div class="mb-3">
        <label class="form-label fw-semibold small text-dark ms-2" for="email">
            <i class="bi bi-envelope-fill me-1 text-muted"></i> Email <span class="text-danger">*</span>
        </label>
        <input id="email" name="email"
               class="form-control form-control-lg rounded-pill px-4 shadow-none"
               style="border-radius: 50px !important; font-size: 0.95rem; border: 1.5px solid #dce2e6;"
               type="email" required maxlength="100"
               placeholder="name@example.com"
               autocomplete="email" />
    </div>

    @if (!Admin)
    {
        <div class="mb-3">
            <label class="form-label fw-semibold small text-dark ms-2" for="phone">
                <i class="bi bi-telephone-fill me-1 text-muted"></i> Số điện thoại liên hệ <span class="text-danger">*</span>
            </label>
            <input id="phone" name="phone"
                   class="form-control form-control-lg rounded-pill px-4 shadow-none"
                   style="border-radius: 50px !important; font-size: 0.95rem; border: 1.5px solid #dce2e6;"
                   type="tel" maxlength="20"
                   placeholder="0912345678"
                   autocomplete="tel" />
        </div>
    }

    <div class="mb-3">
        <label class="form-label fw-semibold small text-dark ms-2" for="password">
            <i class="bi bi-lock-fill me-1 text-muted"></i> Mật khẩu <span class="text-danger">*</span>
        </label>
        <input id="password" name="password"
               class="form-control form-control-lg rounded-pill px-4 shadow-none"
               style="border-radius: 50px !important; font-size: 0.95rem; border: 1.5px solid #dce2e6;"
               type="password" required minlength="10" maxlength="128"
               placeholder="Từ 10 ký tự, gồm cả chữ và số"
               autocomplete="new-password" />
        <small class="text-muted d-block ms-3 mt-1 small">
            <i class="bi bi-info-circle me-1"></i> Tối thiểu 10 ký tự, bao gồm cả chữ cái và chữ số.
        </small>
    </div>

    <div class="mb-4">
        <label class="form-label fw-semibold small text-dark ms-2" for="confirmation">
            <i class="bi bi-shield-check me-1 text-muted"></i> Nhập lại mật khẩu <span class="text-danger">*</span>
        </label>
        <input id="confirmation" name="confirmation"
               class="form-control form-control-lg rounded-pill px-4 shadow-none"
               style="border-radius: 50px !important; font-size: 0.95rem; border: 1.5px solid #dce2e6;"
               type="password" required minlength="10" maxlength="128"
               placeholder="Nhập lại chính xác mật khẩu trên"
               autocomplete="new-password" />
    </div>

    <button class="btn btn-success w-100 rounded-pill py-3 fw-bold fs-6 shadow-sm d-flex align-items-center justify-content-center gap-2"
            style="border-radius: 50px !important;"
            type="submit">
        <i class="bi @(Admin ? "bi-person-plus-fill" : "bi-check2-circle")"></i>
        @(Admin ? "Tạo quản trị viên" : "Đăng ký tài khoản đại lý")
    </button>
</form>

@code {
    [Parameter]
    public string Action { get; set; } = "/auth/register";

    [Parameter]
    public bool Admin { get; set; }
}