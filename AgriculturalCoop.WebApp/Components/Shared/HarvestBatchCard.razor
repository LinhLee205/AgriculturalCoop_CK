<article class="produce-card batch-card">
    <a class="produce-image-link" href="/batches/@Batch.HarvestBatchId" tabindex="-1" aria-hidden="true">
        <img src="@(string.IsNullOrEmpty(Batch.Product?.ImageUrl) ? "/images/products/placeholder.svg" : Batch.Product.ImageUrl)"
             alt="" loading="lazy" onerror="this.onerror=null;this.src='/images/products/placeholder.svg'" />
        <span class="produce-status @(CanOrder ? "" : "is-upcoming")">@StatusText</span>
        <span class="batch-code">@Batch.BatchCode</span>
    </a>
    <div class="produce-body">
        <span class="produce-category">@Batch.Product?.Category</span>
        <h3><a href="/batches/@Batch.HarvestBatchId">@Batch.Product?.ProductName</a></h3>
        <p class="batch-grower"><i class="bi bi-person" aria-hidden="true"></i> @Batch.Member?.FullName</p>
        <div class="produce-price">@Batch.UnitPrice.ToString("N0") <small>đ/@Batch.Product?.Unit</small></div>
        <div class="batch-availability">
            <span>@(CanOrder ? "Còn " + Batch.RemainingQuantity.ToString("N0") + " " + Batch.Product?.Unit : "Dự kiến " + Batch.ExpectedQuantity.ToString("N0") + " " + Batch.Product?.Unit)</span>
            <span><i class="bi bi-calendar3" aria-hidden="true"></i> @Batch.ExpectedHarvestDate.ToString("dd/MM/yyyy")</span>
        </div>
        @if (ShowActions)
        {
            <div class="batch-actions">
                <a href="/batches/@Batch.HarvestBatchId" class="btn btn-sm btn-outline-success">Chi tiết</a>
                @if (CanOrder)
                {
                    <button type="button" class="btn btn-sm btn-success" @onclick="() => OnOrderClick.InvokeAsync(Batch)">Đặt trước ↗</button>
                }
            </div>
        }
    </div>
</article>
@code {
    [Parameter, EditorRequired] public HarvestBatch Batch { get; set; } = null!;
    [Parameter] public bool ShowActions { get; set; } = true;
    [Parameter] public EventCallback<HarvestBatch> OnOrderClick { get; set; }
    private bool CanOrder => Batch.Status == HarvestBatchStatus.OpenForPreOrder && Batch.RemainingQuantity > 0;
    private string StatusText => Batch.Status switch
    {
        HarvestBatchStatus.OpenForPreOrder => Batch.RemainingQuantity > 0 ? "Đang mở đặt trước" : "Đã đủ lượng đặt",
        HarvestBatchStatus.Harvested => "Đã thu hoạch",
        HarvestBatchStatus.Allocated => "Đã phân bổ",
        HarvestBatchStatus.Completed => "Đã hoàn tất",
        _ => "Sắp mở đợt đặt"
    };
}
