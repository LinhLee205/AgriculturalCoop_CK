@page "/batches/{BatchId:int}"
@using System.ComponentModel.DataAnnotations
@inject IViewHarvestBatchByIdUseCase ViewHarvestBatchByIdUseCase
@inject IValidatePreOrderUseCase ValidateOrder
@inject IPreOrderCart Cart
@inject UserSessionState UserSession
@inject NavigationManager Nav

<PageTitle>Chi Tiết Lô Nông Sản - @(batch?.Product?.ProductName ?? "Lô Mùa Vụ")</PageTitle>

@if (loading)
{
    <div class="text-center py-5">
        <div class="spinner-border text-success" role="status"></div>
        <p class="text-muted mt-2">Đang tải thông tin lô...</p>
    </div>
}
else if (batch == null)
{
    <div class="alert alert-danger rounded-4 p-4 text-center">
        Không tìm thấy thông tin lô thu hoạch #@BatchId.
        <div class="mt-3">
            <a href="/batches" class="btn btn-outline-danger">Quay lại danh mục</a>
        </div>
    </div>
}
else
{
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/" class="text-decoration-none text-success">Trang chủ</a></li>
            <li class="breadcrumb-item"><a href="/batches" class="text-decoration-none text-success">Lô mùa vụ</a></li>
            <li class="breadcrumb-item active" aria-current="page">@batch.BatchCode</li>
        </ol>
    </nav>

    <div class="row g-4">
        <!-- Cột Trái: Ảnh và Thông tin Lô -->
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm overflow-hidden bg-white mb-4" style="border-radius: 24px; border: 1px solid #edf2f7 !important;">
                <div class="position-relative" style="background: #f8fafc; text-align: center;">
                    <img src="@(string.IsNullOrEmpty(batch.Product?.ImageUrl) ? "/images/products/placeholder.svg" : batch.Product.ImageUrl)"
                         style="width: 100%; max-height: 380px; object-fit: contain; padding: 24px; transition: transform 0.3s ease;"
                         alt="@batch.Product?.ProductName"
                         onerror="this.onerror=null;this.src='/images/products/placeholder.svg'" />

                    <!-- Badges overlay trên ảnh -->
                    <div class="position-absolute top-0 start-0 p-3 d-flex flex-wrap gap-2">
                        <span class="badge rounded-pill px-3 py-2 text-white shadow-xs" style="background: rgba(45, 106, 79, 0.9); backdrop-filter: blur(6px); font-size: 0.82rem; font-weight: 600;">
                            <i class="bi bi-shield-check me-1"></i> VietGAP · @batch.Product?.Category
                        </span>
                    </div>
                    <div class="position-absolute top-0 end-0 p-3">
                        <span class="badge rounded-pill bg-dark bg-opacity-75 font-monospace px-3 py-2 shadow-xs" style="font-size: 0.82rem;">
                            Lô: @batch.BatchCode
                        </span>
                    </div>
                </div>
                
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-1 rounded-pill">
                            @batch.Product?.Category
                        </span>
                        <span class="badge bg-dark text-white font-monospace px-2 py-1">
                            Mã: @batch.BatchCode
                        </span>
                    </div>

                    <h2 class="fw-bold text-dark mb-2">@batch.Product?.ProductName</h2>
                    <p class="text-muted">@batch.Product?.Description</p>

                    <hr class="my-4" />

                    <!-- 4 Thẻ Thông số kỹ thuật lô mùa vụ bo tròn hiện đại -->
                    <div class="row g-3 mb-4">
                        <div class="col-sm-6">
                            <div class="p-3 bg-light border-0 shadow-xs h-100" style="border-radius: 18px; background: #f8fafc !important; border: 1px solid #eef2f6 !important;">
                                <div class="d-flex align-items-center gap-2 mb-1">
                                    <div class="rounded-circle d-flex align-items-center justify-content-center text-success bg-white shadow-xs" style="width: 32px; height: 32px;">
                                        <i class="bi bi-person-fill"></i>
                                    </div>
                                    <small class="text-muted fw-semibold">Hộ Xã Viên Canh Tác</small>
                                </div>
                                <strong class="text-dark d-block fs-6 ps-1">@batch.Member?.FullName</strong>
                                <small class="text-muted ps-1 d-block text-truncate" title="@batch.Member?.Address">
                                    <i class="bi bi-geo-alt text-danger me-1"></i>@(string.IsNullOrWhiteSpace(batch.Member?.Address) ? "Vùng trồng Thừa Thiên Huế" : batch.Member.Address)
                                </small>
                            </div>
                        </div>

                        <div class="col-sm-6">
                            <div class="p-3 bg-light border-0 shadow-xs h-100" style="border-radius: 18px; background: #f8fafc !important; border: 1px solid #eef2f6 !important;">
                                <div class="d-flex align-items-center gap-2 mb-1">
                                    <div class="rounded-circle d-flex align-items-center justify-content-center text-success bg-white shadow-xs" style="width: 32px; height: 32px;">
                                        <i class="bi bi-tag-fill"></i>
                                    </div>
                                    <small class="text-muted fw-semibold">Giá Sỉ Chốt Bao Tiêu</small>
                                </div>
                                <strong class="text-success d-block fs-5 ps-1">@batch.UnitPrice.ToString("N0") VNĐ</strong>
                                <small class="text-muted ps-1">Đơn vị: /@batch.Product?.Unit (Giá cố định)</small>
                            </div>
                        </div>

                        <div class="col-sm-6">
                            <div class="p-3 bg-light border-0 shadow-xs h-100" style="border-radius: 18px; background: #f8fafc !important; border: 1px solid #eef2f6 !important;">
                                <div class="d-flex align-items-center gap-2 mb-1">
                                    <div class="rounded-circle d-flex align-items-center justify-content-center text-primary bg-white shadow-xs" style="width: 32px; height: 32px;">
                                        <i class="bi bi-box-seam-fill"></i>
                                    </div>
                                    <small class="text-muted fw-semibold">Sản Lượng Dự Kiến</small>
                                </div>
                                <strong class="text-dark d-block fs-5 ps-1">@batch.ExpectedQuantity.ToString("N0") kg</strong>
                                <small class="text-muted ps-1">Quy mô toàn lô thu hoạch</small>
                            </div>
                        </div>

                        <div class="col-sm-6">
                            <div class="p-3 bg-light border-0 shadow-xs h-100" style="border-radius: 18px; background: #f8fafc !important; border: 1px solid #eef2f6 !important;">
                                <div class="d-flex align-items-center gap-2 mb-1">
                                    <div class="rounded-circle d-flex align-items-center justify-content-center text-info bg-white shadow-xs" style="width: 32px; height: 32px;">
                                        <i class="bi bi-calendar-event-fill"></i>
                                    </div>
                                    <small class="text-muted fw-semibold">Ngày Dự Kiến Thu Hoạch</small>
                                </div>
                                <strong class="text-primary d-block fs-5 ps-1">@batch.ExpectedHarvestDate.ToString("dd/MM/yyyy")</strong>
                                <small class="text-muted ps-1">Đang theo sát lịch cắt tại vườn</small>
                            </div>
                        </div>
                    </div>

                    <!-- Cam kết dịch vụ HTX -->
                    <div class="p-3 rounded-4 bg-success-subtle text-success-emphasis border border-success-subtle d-flex flex-wrap justify-content-around gap-2 small">
                        <span><i class="bi bi-check-circle-fill text-success me-1"></i> Vận chuyển xe lạnh 24h</span>
                        <span><i class="bi bi-check-circle-fill text-success me-1"></i> Truy xuất QR nguồn gốc</span>
                        <span><i class="bi bi-check-circle-fill text-success me-1"></i> Phân bổ tỷ lệ công bằng</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Cột Phải: Tiến Độ Đặt & Form Đặt Trước (Kiểm tra Luật 1) -->
        <div class="col-lg-5">
            <div class="card border-0 shadow-sm p-4 bg-white sticky-top" style="top: 85px; border-radius: 24px; border: 1.5px solid #edf2f7 !important;">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h4 class="fw-bold text-dark mb-0" style="font-size: 1.35rem; color: #143823 !important;">
                        Đặt Trước Lô Nông Sản
                    </h4>
                    <span class="badge bg-success-subtle text-success rounded-pill px-2-5 py-1 small fw-semibold">
                        Mùa vụ @DateTime.Now.Year
                    </span>
                </div>

                <!-- Thống kê sản lượng khả dụng -->
                <div class="p-3 rounded-4 border mb-3" style="background: #f8fafc; border-color: #e2e8f0 !important;">
                    <div class="d-flex justify-content-between small text-muted mb-1-5">
                        <span>Đã được đặt: <strong class="text-dark">@batch.TotalOrderedQuantity.ToString("N0") kg</strong></span>
                        <span>Dự kiến: <strong class="text-dark">@batch.ExpectedQuantity.ToString("N0") kg</strong></span>
                    </div>

                    @{
                        decimal percent = batch.ExpectedQuantity > 0 
                            ? Math.Min(100, Math.Round((batch.TotalOrderedQuantity / batch.ExpectedQuantity) * 100m, 1)) 
                            : 0;
                    }
                    <div class="progress mb-2 rounded-pill overflow-hidden" style="height: 10px; background: #e2e8f0;">
                        <div class="progress-bar @(percent >= 100 ? "bg-danger" : "bg-success")" 
                             role="progressbar"
                             style="width: @percent%; transition: width 0.5s ease;"></div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center pt-1">
                        <span class="small text-secondary">Số lượng khả dụng còn lại:</span>
                        <span class="badge @(batch.RemainingQuantity > 0 ? "bg-success" : "bg-danger") px-3 py-1-5 rounded-pill shadow-xs" style="font-size: 0.9rem;">
                            @batch.RemainingQuantity.ToString("N0") kg
                        </span>
                    </div>
                </div>

                @if (batch.RemainingQuantity <= 0 || batch.Status != HarvestBatchStatus.OpenForPreOrder)
                {
                    <div class="alert alert-warning rounded-4 small p-3">
                        <i class="bi bi-exclamation-triangle-fill me-1"></i>
                        Lô nông sản này đã đạt giới hạn sản lượng dự kiến hoặc đã đóng nhận đặt trước.
                    </div>
                }
                else
                {
                    <!-- EditForm + DataAnnotations (K3.2 - 5 điểm) -->
                    <EditForm Model="@orderModel" OnValidSubmit="HandleOrderSubmit">
                        <DataAnnotationsValidator />

                        <!-- Thông báo vi phạm Luật 1 (K3.3 - 4 điểm) -->
                        @if (!string.IsNullOrEmpty(businessRuleErrorMessage))
                        {
                            <div class="alert alert-danger rounded-4 small py-2-5 px-3 mb-3 d-flex align-items-center gap-2">
                                <i class="bi bi-shield-x fs-4 text-danger flex-shrink-0"></i>
                                <div>
                                    <strong class="d-block">Chưa thể đặt hàng:</strong>
                                    <span>@businessRuleErrorMessage</span>
                                </div>
                            </div>
                        }

                        @if (!string.IsNullOrEmpty(successMessage))
                        {
                            <div class="alert alert-success rounded-4 small py-2-5 px-3 mb-3 d-flex align-items-center gap-2">
                                <i class="bi bi-check-circle-fill fs-4 text-success flex-shrink-0"></i>
                                <div>@successMessage</div>
                            </div>
                        }

                        <div class="mb-3">
                            <label class="form-label fw-semibold small text-dark mb-1">
                                Đại lý đặt hàng:
                            </label>
                            <input type="text" class="form-control bg-light rounded-pill px-3" value="@UserSession.CurrentDealerName" readonly />
                            <small class="text-muted d-block mt-1" style="font-size: 0.76rem;">Đăng nhập tài khoản đại lý để đặt trước nông sản.</small>
                        </div>

                        <div class="mb-3">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <label class="form-label fw-semibold small text-dark mb-0">
                                    Số lượng đặt trước (kg) <span class="text-danger">*</span>
                                </label>
                                @if (batch.RemainingQuantity > 0)
                                {
                                    <button type="button" class="btn btn-sm btn-link text-decoration-none text-success p-0 fw-semibold" style="font-size: 0.78rem;"
                                            @onclick="() => orderModel.Quantity = batch.RemainingQuantity">
                                        Đặt tối đa (@batch.RemainingQuantity.ToString("N0") kg)
                                    </button>
                                }
                            </div>
                            <InputNumber @bind-Value="orderModel.Quantity" class="form-control form-control-lg fw-bold rounded-pill px-3 shadow-none border" placeholder="Nhập số kg..." />
                            <!-- Lỗi DataAnnotations hiển thị cạnh ô nhập (K3.2) -->
                            <ValidationMessage For="@(() => orderModel.Quantity)" class="validation-message" />
                            <small class="text-muted d-block mt-1" style="font-size: 0.78rem;">
                                Tối đa có thể đặt: <strong class="text-success">@batch.RemainingQuantity.ToString("N0") kg</strong>
                            </small>
                        </div>

                        <div class="mb-4">
                            <div class="d-flex justify-content-between align-items-center p-3 rounded-4 bg-light border" style="border-radius: 18px !important;">
                                <span class="fw-semibold text-muted small">Ước tính tiền hàng:</span>
                                <span class="fw-bold fs-5 text-success">
                                    @((orderModel.Quantity * batch.UnitPrice).ToString("N0")) VNĐ
                                </span>
                            </div>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-success btn-lg fw-bold rounded-pill shadow-sm py-2-5"
                                    style="background: linear-gradient(135deg, #2d6a4f 0%, #1b4332 100%); border: none;">
                                <i class="bi bi-cart-check-fill me-1"></i> Tiếp tục nhập thông tin nhận hàng
                            </button>
                            <button type="button" class="btn btn-outline-secondary rounded-pill py-2" @onclick="AddToCartOnly">
                                <i class="bi bi-cart-plus me-1"></i> Thêm vào giỏ
                            </button>
                        </div>
                    </EditForm>
                }
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public int BatchId { get; set; }

    private HarvestBatch? batch;
    private bool loading = true;
    private string? businessRuleErrorMessage;
    private string? successMessage;

    public class PreOrderInputModel
    {
        [Required(ErrorMessage = "Vui lòng nhập khối lượng muốn đặt trước.")]
        [Range(typeof(decimal), "0.01", "100000", ErrorMessage = "Khối lượng đặt từ 0,01 kg đến 100.000 kg.")]
        public decimal Quantity { get; set; } = 1;
    }

    private PreOrderInputModel orderModel = new();

    protected override async Task OnInitializedAsync()
    {
        await UserSession.InitializeAsync();
        await LoadBatch();
    }

    private async Task LoadBatch()
    {
        loading = true;
        batch = await ViewHarvestBatchByIdUseCase.ExecuteAsync(BatchId);
        if (batch is not { Status: HarvestBatchStatus.OpenForPreOrder, IsArchived: false }) batch = null;
        loading = false;
    }

    private async Task HandleOrderSubmit()
    {
        businessRuleErrorMessage = null;
        successMessage = null;

        if (batch == null) return;
        await UserSession.InitializeAsync();

        if (!UserSession.IsDealer)
        {
            Nav.NavigateTo(
                "/account/login?returnUrl=" +
                Uri.EscapeDataString("/batches/" + BatchId),
                forceLoad: true);

            return;
        }


        // Tạo đối tượng PreOrder với 1 dòng PreOrderLine
        var preOrder = new PreOrder
        {
            DealerId = UserSession.CurrentDealerId,
            OrderDate = DateTime.Now,
            Status = PreOrderStatus.Confirmed,
            Notes = $"Đại lý {UserSession.CurrentDealerName} đặt trực tiếp tại trang chi tiết lô {batch.BatchCode}"
        };

        var line = new PreOrderLine
        {
            HarvestBatchId = batch.HarvestBatchId,
            Quantity = orderModel.Quantity,
            UnitPrice = batch.UnitPrice
        };
        preOrder.PreOrderLines.Add(line);
        preOrder.PreOrderLines.AddRange(Cart.Items
            .Where(i => i.HarvestBatchId != batch.HarvestBatchId)
            .Select(i => new PreOrderLine { HarvestBatchId = i.HarvestBatchId, Quantity = i.Quantity }));

        try
        {
            // Gọi UseCase: Nơi LUẬT 1 (K1.3) và TRANSACTION (K2.2) được thực thi!
            await ValidateOrder.ValidateAsync(preOrder);
            Cart.SetOrAddItem(batch, orderModel.Quantity);
            Nav.NavigateTo("/checkout");
        }
        catch (ExceededExpectedYieldException ex)
        {
            // Bắt lỗi vi phạm Luật 1 để hiển thị thân thiện, KHÔNG văng lỗi ứng dụng (K3.3)
            businessRuleErrorMessage = ex.Message;
        }
        catch (Exception ex)
        {
            businessRuleErrorMessage = $"Lỗi: {ex.Message}";
        }
    }

    private void AddToCartOnly()
    {
        if (batch == null) return;
        if (orderModel.Quantity > batch.RemainingQuantity)
        {
            businessRuleErrorMessage = $"Số lượng muốn thêm ({orderModel.Quantity:N0} kg) vượt quá sản lượng còn lại của lô ({batch.RemainingQuantity:N0} kg).";
            return;
        }

        Cart.SetOrAddItem(batch, orderModel.Quantity);
        Nav.NavigateTo("/cart");
    }
}
