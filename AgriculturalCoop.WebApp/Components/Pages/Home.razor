@page "/"
@inject IViewProductsUseCase ViewProducts
@inject IViewOpenBatchesUseCase ViewOpenBatches
@inject IHomeBannerUseCases Banners

<PageTitle>COOPAGRI — Nông sản tươi theo mùa</PageTitle>
<StoreBanner Banner="banner" />
<div class="store-promises" aria-label="Cam kết của hợp tác xã">
    <span><i class="bi bi-flower1" aria-hidden="true"></i> Tươi từ nông trại</span>
    <span><i class="bi bi-people" aria-hidden="true"></i> Kết nối người trồng</span>
    <span><i class="bi bi-calendar-heart" aria-hidden="true"></i> Chọn đúng mùa, trọn vị ngon</span>
</div>
<section id="nong-san" class="store-catalog">
    <div class="catalog-heading">
        <div>
            <span class="eyebrow">TỪ NHỮNG KHU VƯỜN TẬN TÂM</span>
            <h2>Nông sản & mùa vụ</h2>
            <p>Thông tin sản phẩm và các lô thu hoạch sắp tới của hợp tác xã.</p>
        </div>
        <a class="catalog-more" href="/products">Xem tất cả nông sản <span aria-hidden="true">→</span></a>
    </div>
    @if (loading)
    {
        <p role="status" class="text-muted">Đang tải nông sản…</p>
    }
    else if (products.Count == 0)
    {
        <div class="store-empty">Danh mục nông sản đang được cập nhật. Hẹn bạn ghé lại sớm!</div>
    }
    else
    {
        <div class="catalog-grid">
            @foreach (var product in products)
            {
                <ProductCard @key="product.ProductId" Product="product"
                             OpenBatch="openBatches.FirstOrDefault(b => b.ProductId == product.ProductId)" />
            }
        </div>
    }
</section>
@code {
    private HomeBanner banner = new();
    private List<Product> products = new();
    private List<HarvestBatch> openBatches = new();
    private bool loading = true;
    protected override async Task OnInitializedAsync()
    {
        banner = await Banners.GetAsync();
        openBatches = (await ViewOpenBatches.ExecuteAsync()).ToList();
        products = (await ViewProducts.ExecuteAsync())
            .OrderBy(p => openBatches.Where(b => b.ProductId == p.ProductId)
                .Select(b => b.ExpectedHarvestDate).DefaultIfEmpty(DateTime.MaxValue).Min())
            .ThenBy(p => p.ProductName).Take(8).ToList();
        loading = false;
    }
}
