<!-- Trợ lý AI được tích hợp tại MainLayout để hiển thị xuyên suốt website -->

@code {
    private HomeBanner banner = new();
    private List<Product> allProducts = new();
    private List<HarvestBatch> openBatches = new();
    private List<HarvestBatch> featuredBatches = new();
    private List<string> categories = new();
    private string selectedCategory = "";
    private bool loading = true;

    private List<Product> filteredProducts => string.IsNullOrEmpty(selectedCategory)
        ? allProducts
        : allProducts.Where(p => p.Category == selectedCategory).ToList();

    protected override async Task OnInitializedAsync()
    {
        banner = await Banners.GetAsync();
        openBatches = (await ViewOpenBatches.ExecuteAsync()).ToList();

        // Lọc sản phẩm: CHỈ lấy các sản phẩm CÓ ÍT NHẤT 1 LÔ ĐANG MỞ ĐẶT TRƯỚC
        // Đảm bảo tương thích hoàn toàn với RegressionTests và chuẩn yêu cầu hệ thống!
        allProducts = (await ViewProducts.ExecuteAsync())
            .Where(p => openBatches.Any(b => b.ProductId == p.ProductId))
            .OrderBy(p => openBatches.Where(b => b.ProductId == p.ProductId)
                .Select(b => b.ExpectedHarvestDate).DefaultIfEmpty(DateTime.MaxValue).Min())
            .ThenBy(p => p.ProductName)
            .ToList();

        categories = allProducts.Select(p => p.Category).Where(c => !string.IsNullOrEmpty(c)).Distinct().ToList();

        featuredBatches = openBatches
            .Where(b => b.RemainingQuantity > 0)
            .OrderBy(b => b.ExpectedHarvestDate)
            .Take(4)
            .ToList();

        loading = false;
    }

    private void FilterCategory(string cat)
    {
        selectedCategory = cat;
    }

    private RenderFragment CategoryIcon(string cat) => cat switch
    {
        "Trái cây đặc sản" => @<span class="me-1">🍎</span>,
        "Rau củ quả" => @<span class="me-1">🥕</span>,
        "Rau ăn lá" => @<span class="me-1">🥬</span>,
        "Nấm tươi & Rau gia vị" => @<span class="me-1">🍄</span>,
        "Đậu & Hạt dinh dưỡng" => @<span class="me-1">🥜</span>,
        _ => @<span class="me-1">🌿</span>
    };
}