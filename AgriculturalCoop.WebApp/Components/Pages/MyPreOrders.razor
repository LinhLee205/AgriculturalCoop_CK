@page "/my-orders"
@inject IViewPreOrdersByDealerUseCase ViewPreOrdersByDealerUseCase
@inject UserSessionState UserSession
@inject NavigationManager Nav

<PageTitle>Đơn Đặt Trước Của Tôi - Đại Lý</PageTitle>

<div class="mb-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-1">Đơn Đặt Trước Của Tôi</h2>
            <p class="text-muted small mb-0">
                Đang xem với tư cách: <strong class="text-success">@UserSession.CurrentDealerName</strong>
            </p>
        </div>
        <a href="/batches" class="btn btn-outline-success rounded-pill px-4 btn-sm fw-semibold">
            <i class="bi bi-plus-circle me-1"></i> Đặt thêm lô mới
        </a>
    </div>

    @if (loading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-success" role="status"></div>
            <p class="text-muted mt-2">Đang tải lịch sử đơn...</p>
        </div>
    }
    else if (!orders.Any())
    {
        <div class="card border-0 rounded-4 shadow-sm p-5 text-center bg-white">
            <i class="bi bi-journal-x text-muted fs-1 mb-3"></i>
            <h4 class="fw-bold text-dark">Chưa có đơn đặt trước nào</h4>
            <p class="text-muted small">Quý đại lý chưa có đơn đặt trước nào trong hệ thống.</p>
            <div class="mt-2">
                <a href="/batches" class="btn btn-success rounded-pill px-4">Đặt trước ngay</a>
            </div>
        </div>
    }
    else
    {
        <div class="d-flex flex-column gap-4">
            @foreach (var order in orders)
            {
                <div class="card border-0 rounded-4 shadow-sm bg-white overflow-hidden">
                    <div class="card-header bg-light border-bottom p-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
                        <div class="d-flex align-items-center gap-3">
                            <span class="badge bg-dark font-monospace px-3 py-2 rounded-3 fs-6">
                                @order.OrderNumber
                            </span>
                            <span class="text-muted small">
                                <i class="bi bi-calendar3 me-1"></i> Ngày đặt: @order.OrderDate.ToString("dd/MM/yyyy HH:mm")
                            </span>
                        </div>

                        <div>
                            @if (order.Status == PreOrderStatus.Confirmed)
                            {
                                <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 rounded-pill fw-semibold">
                                    <i class="bi bi-check-circle me-1"></i> Đã xác nhận bao tiêu
                                </span>
                            }
                            else if (order.Status == PreOrderStatus.PartiallyAllocated || order.Status == PreOrderStatus.FullyAllocated)
                            {
                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-2 rounded-pill fw-semibold">
                                    <i class="bi bi-pie-chart-fill me-1"></i> Đã phân bổ sản lượng
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary-subtle text-secondary px-3 py-2 rounded-pill">
                                    @order.Status
                                </span>
                            }
                        </div>
                    </div>

                    <div class="card-body p-4">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Mã Lô Nông Sản</th>
                                        <th>Khối Lượng Đặt</th>
                                        <th>Đơn Giá</th>
                                        <th>Thành Tiền Dự Kiến</th>
                                        <th>Thực Tế Được Phân Bổ</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var line in order.PreOrderLines)
                                    {
                                        <tr>
                                            <td>
                                                <div class="fw-bold text-dark">@(line.HarvestBatch?.Product?.ProductName ?? $"Lô #{line.HarvestBatchId}")</div>
                                                <small class="text-muted font-monospace">@line.HarvestBatch?.BatchCode</small>
                                            </td>
                                            <td class="fw-bold">
                                                @line.Quantity.ToString("N0") kg
                                            </td>
                                            <td>
                                                @line.UnitPrice.ToString("N0") đ/kg
                                            </td>
                                            <td class="text-dark fw-semibold">
                                                @line.LineTotal.ToString("N0") đ
                                            </td>
                                            <td>
                                                @if (line.Allocation != null)
                                                {
                                                    <span class="badge bg-warning text-dark px-3 py-2 rounded-pill fw-bold">
                                                        <i class="bi bi-box-seam me-1"></i> @line.Allocation.AllocatedQuantity.ToString("N0") kg
                                                    </span>
                                                    <div class="small text-muted mt-1 fst-italic">
                                                        @line.Allocation.Reason
                                                    </div>
                                                }
                                                else
                                                {
                                                    <span class="text-muted small">
                                                        <i class="bi bi-hourglass-split"></i> Chờ HTX thu hoạch
                                                    </span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mt-3 pt-3 border-top">
                            <div class="text-muted small">
                                <i class="bi bi-chat-left-text me-1"></i> Ghi chú: @(string.IsNullOrEmpty(order.Notes) ? "Không có" : order.Notes)
                            </div>
                            <div>
                                <span class="text-muted me-2">Tổng giá trị đơn:</span>
                                <span class="fs-5 fw-extrabold text-success">@order.TotalAmount.ToString("N0") VNĐ</span>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private List<PreOrder> orders = new();
    private bool loading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadOrders();
        UserSession.OnSessionChanged += async () =>
        {
            await LoadOrders();
            StateHasChanged();
        };
    }

    private async Task LoadOrders()
    {
        loading = true;
        var list = await ViewPreOrdersByDealerUseCase.ExecuteAsync(UserSession.CurrentDealerId);
        orders = list.ToList();
        loading = false;
    }
}
