@page "/admin/allocations/{BatchId:int}"
@inject UserSessionState UserSession
@inject NavigationManager Nav
@inject IViewHarvestBatchByIdUseCase ViewHarvestBatchByIdUseCase
@inject IAllocateHarvestUseCase AllocateHarvestUseCase
@inject IViewAllocationsByBatchUseCase ViewAllocationsByBatchUseCase
@inject IGenerateAllocationNoticeUseCase GenerateAllocationNoticeUseCase

<PageTitle>Quản Lý Phân Bổ Sản Lượng Mùa Vụ (Luật 2)</PageTitle>

@if (!UserSession.IsAdmin)
{
    <div class="alert alert-danger p-4 rounded-4 text-center my-5">
        <i class="bi bi-shield-lock-fill fs-1 text-danger mb-2 d-block"></i>
        <h4 class="fw-bold">Truy cập bị từ chối (K4.2)</h4>
        <p class="text-muted">Chức năng phân bổ sản lượng chỉ dành cho Ban Quản trị Hợp tác xã.</p>
    </div>
}
else if (loading)
{
    <div class="text-center py-5">
        <div class="spinner-border text-success" role="status"></div>
        <p class="text-muted mt-2">Đang tải dữ liệu lô mùa vụ...</p>
    </div>
}
else if (batch == null)
{
    <div class="alert alert-danger rounded-4 p-4 text-center">
        Không tìm thấy lô thu hoạch #@BatchId.
    </div>
}
else
{
    <div class="mb-4">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1">
                <li class="breadcrumb-item"><a href="/admin" class="text-decoration-none text-muted">Quản trị</a></li>
                <li class="breadcrumb-item"><a href="/admin/batches" class="text-decoration-none text-muted">Lô mùa vụ</a></li>
                <li class="breadcrumb-item active">Phân bổ sản lượng</li>
            </ol>
        </nav>
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
            <div>
                <span class="badge bg-warning text-dark px-3 py-1 rounded-pill fw-bold mb-2">
                    LUẬT NGHIỆP VỤ 2 (K1.3 / K5.2)
                </span>
                <h2 class="fw-bold text-dark mb-0">Thuật Toán Phân Bổ Sản Lượng Thực Tế</h2>
                <p class="text-muted small mb-0">
                    Lô: <strong class="text-dark">@batch.BatchCode - @batch.Product?.ProductName</strong> | Xã viên: @batch.Member?.FullName
                </p>
            </div>
            <a href="/admin/batches" class="btn btn-outline-secondary rounded-pill px-3 btn-sm">
                <i class="bi bi-arrow-left me-1"></i> Quay lại danh sách lô
            </a>
        </div>

        @if (!string.IsNullOrEmpty(successMessage))
        {
            <div class="alert alert-success rounded-4 py-3 px-4 mb-4 d-flex align-items-center gap-3 shadow-xs">
                <i class="bi bi-check-circle-fill fs-2 text-success"></i>
                <div>
                    <h6 class="fw-bold mb-0">Phân Bổ Hoàn Tất & Ghi Nhận Trong 1 Transaction (K2.2)!</h6>
                    <small class="mb-0">@successMessage</small>
                </div>
            </div>
        }

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger rounded-4 py-3 px-4 mb-4 d-flex align-items-center gap-3 shadow-xs">
                <i class="bi bi-exclamation-triangle-fill fs-2 text-danger"></i>
                <div>
                    <h6 class="fw-bold mb-0">Lỗi Thực Thi Nghiệp Vụ</h6>
                    <small class="mb-0">@errorMessage</small>
                </div>
            </div>
        }

        <!-- 3 Thẻ So Sánh Chỉ Số Cốt Lõi -->
        <div class="row g-3 mb-4">
            <div class="col-md-4">
                <div class="card border-0 rounded-4 shadow-sm p-4 bg-white text-center h-100">
                    <span class="text-muted small fw-semibold">SẢN LƯỢNG DỰ KIẾN (BAN ĐẦU)</span>
                    <h2 class="fw-bold text-dark my-2">@batch.ExpectedQuantity.ToString("N0") <small class="fs-6 text-muted">kg</small></h2>
                    <small class="text-muted">Kế hoạch vụ mùa</small>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card border-0 rounded-4 shadow-sm p-4 bg-white text-center h-100">
                    <span class="text-muted small fw-semibold">TỔNG ĐẠI LÝ ĐẶT TRƯỚC</span>
                    <h2 class="fw-bold text-primary my-2">@batch.TotalOrderedQuantity.ToString("N0") <small class="fs-6 text-muted">kg</small></h2>
                    <small class="text-success fw-semibold">
                        <i class="bi bi-check2"></i> Hợp lệ vì &le; @batch.ExpectedQuantity.ToString("N0") kg (Luật 1)
                    </small>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card border-0 rounded-4 shadow-sm p-4 bg-warning bg-opacity-10 border border-warning border-opacity-25 text-center h-100">
                    <span class="text-warning-emphasis small fw-bold">SẢN LƯỢNG THỰC TẾ THU HOẠCH</span>
                    <div class="input-group input-group-lg my-2 justify-content-center">
                        <input type="number" 
                               class="form-control text-center fw-extrabold text-warning-emphasis border-warning" 
                               style="max-width: 160px;" 
                               @bind="actualYieldInput" />
                        <span class="input-group-text bg-warning text-dark fw-bold border-warning">kg</span>
                    </div>
                    <small class="text-danger fw-semibold">
                        @(actualYieldInput < batch.TotalOrderedQuantity 
                            ? $"Hụt mùa: Thiếu {(batch.TotalOrderedQuantity - actualYieldInput):N0} kg so với lượng đặt!" 
                            : "Sản lượng thực tế đủ đáp ứng 100% đơn đặt")
                    </small>
                </div>
            </div>
        </div>

        <!-- Khối Kích Hoạt Thuật Toán Phân Bổ (Luật 2) -->
        <div class="card border-0 rounded-4 shadow-sm p-4 bg-white mb-4">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                <div>
                    <h5 class="fw-bold text-dark mb-1">
                        <i class="bi bi-gear-wide-connected text-success me-2"></i> Kích Hoạt Thuật Toán Phân Bổ Tỷ Lệ
                    </h5>
                    <p class="text-muted small mb-0">
                        Áp dụng giải thuật <strong>Proportional Distribution</strong> kết hợp <strong>Largest Remainder (Hamilton-Hare)</strong>.
                        Bảo đảm tuyệt đối: <code class="text-danger fw-bold">&sum; Phân bổ &equiv; Sản lượng thực tế</code> (Không lệch 1 kg nào).
                    </p>
                </div>
                <div>
                    <button class="btn btn-warning btn-lg text-dark fw-bold rounded-pill px-4 shadow-sm" 
                            disabled="@isCalculating" 
                            @onclick="RunAllocationAlgorithm">
                        @if (isCalculating)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                            <span>Đang phân bổ...</span>
                        }
                        else
                        {
                            <span><i class="bi bi-lightning-charge-fill me-1"></i> Chạy Phân Bổ Ngay</span>
                        }
                    </button>
                </div>
            </div>
        </div>

        <!-- Bảng Kết Quả Phân Bổ Chi Tiết -->
        @if (allocationResults.Any())
        {
            <div class="card border-0 rounded-4 shadow-sm bg-white p-4 mb-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold text-dark mb-0">
                        <i class="bi bi-card-checklist text-primary me-2"></i> Bảng Phân Bổ Sản Lượng Từng Đại Lý
                    </h5>
                    <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 rounded-pill fw-semibold">
                        Đã khớp: @(allocationResults.Sum(r => r.AllocatedQuantity).ToString("N0")) / @actualYieldInput.ToString("N0") kg thực tế (100%)
                    </span>
                </div>

                @foreach (var item in allocationResults)
                {
                    <AllocationResultCard Item="item" OnGenerateNotice="HandleGenerateAiNotice" />
                }

                <!-- Đối soát tổng kết K5.2 -->
                <div class="p-3 rounded-3 bg-light border mt-3">
                    <div class="row align-items-center text-center text-md-start">
                        <div class="col-md-4">
                            <span class="text-muted small">Tổng Khối Lượng Đặt Trước:</span>
                            <div class="fw-bold fs-5 text-dark">@(allocationResults.Sum(r => r.RequestedQuantity).ToString("N0")) kg</div>
                        </div>
                        <div class="col-md-4">
                            <span class="text-muted small">Tổng Khối Lượng Được Phân Bổ:</span>
                            <div class="fw-bold fs-5 text-success">@(allocationResults.Sum(r => r.AllocatedQuantity).ToString("N0")) kg</div>
                        </div>
                        <div class="col-md-4 text-md-end">
                            <span class="badge bg-success px-3 py-2 rounded-pill fs-6 fw-bold">
                                <i class="bi bi-shield-check me-1"></i> Khớp Sản Lượng Thực 100%
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Modal AI Soạn Thảo Thông Báo (K4.3 - Tính năng nâng cao AI) -->
    @if (selectedItemForNotice != null)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);">
            <div class="modal-dialog modal-dialog-centered modal-lg">
                <div class="modal-content rounded-4 border-0 shadow-lg">
                    <div class="modal-header border-bottom bg-light">
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge bg-primary rounded-pill p-2"><i class="bi bi-robot"></i></span>
                            <h5 class="modal-title fw-bold">AI Trợ Lý: Soạn Thông Báo Phân Bổ Cho Đại Lý (K4.3)</h5>
                        </div>
                        <button type="button" class="btn-close" @onclick="() => selectedItemForNotice = null"></button>
                    </div>
                    <div class="modal-body p-4">
                        <div class="alert alert-info small rounded-3 mb-3">
                            <i class="bi bi-info-circle me-1"></i>
                            Tính năng AI (IChatClient) tự động tổng hợp số liệu hụt mùa từ CSDL và tạo bản nháp thư thông báo minh bạch cho đại lý. Ban Quản trị có thể chỉnh sửa trước khi gửi.
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold small text-muted">Lý do mùa vụ khách quan:</label>
                            <input class="form-control" @bind="aiWeatherReason" placeholder="Ví dụ: Mưa bão kéo dài đầu tháng làm giảm tỷ lệ đậu quả..." />
                        </div>

                        <div class="mb-3">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <label class="form-label fw-bold small text-dark mb-0">Nội dung thư thông báo gửi đại lý:</label>
                                <button class="btn btn-outline-primary btn-sm rounded-pill px-3" @onclick="RegenerateNotice">
                                    <i class="bi bi-arrow-clockwise me-1"></i> Tạo lại nội dung
                                </button>
                            </div>
                            <textarea class="form-control font-monospace small" rows="12" @bind="generatedNoticeContent"></textarea>
                        </div>
                    </div>
                    <div class="modal-footer border-top">
                        <button type="button" class="btn btn-light rounded-pill px-4" @onclick="() => selectedItemForNotice = null">Đóng</button>
                        <button type="button" class="btn btn-success rounded-pill px-4 fw-bold" @onclick="ApproveAndSendNotice">
                            <i class="bi bi-send-check me-1"></i> Ban Quản Trị Duyệt & Gửi
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
}

@code {
    [Parameter]
    public int BatchId { get; set; }

    private HarvestBatch? batch;
    private decimal actualYieldInput = 720; // Giá trị ví dụ đề bài
    private bool loading = true;
    private bool isCalculating = false;
    private string? successMessage;
    private string? errorMessage;

    private List<AllocationResultItem> allocationResults = new();

    // AI Notice feature
    private AllocationResultItem? selectedItemForNotice;
    private string aiWeatherReason = "Mưa lũ đầu vụ ảnh hưởng nhẹ đến năng suất thu hoạch";
    private string generatedNoticeContent = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        if (UserSession.IsAdmin)
        {
            await LoadBatchData();
        }
    }

    private async Task LoadBatchData()
    {
        loading = true;
        batch = await ViewHarvestBatchByIdUseCase.ExecuteAsync(BatchId);
        if (batch != null && batch.ActualQuantity.HasValue)
        {
            actualYieldInput = batch.ActualQuantity.Value;
        }
        loading = false;
    }

    private async Task RunAllocationAlgorithm()
    {
        if (batch == null) return;
        isCalculating = true;
        errorMessage = null;
        successMessage = null;

        try
        {
            // Thực thi UseCase: Kích hoạt LUẬT NGHIỆP VỤ 2 (K1.3 / K5.2) và Lưu trong 1 TRANSACTION (K2.2)
            var results = await AllocateHarvestUseCase.ExecuteAsync(BatchId, actualYieldInput);
            allocationResults = results;
            successMessage = $"Thuật toán phân bổ hoàn tất! Đã phân bổ chính xác {actualYieldInput:N0} kg cho {results.Count} đơn đặt trước trong 1 Transaction duy nhất.";
            await LoadBatchData();
        }
        catch (Exception ex)
        {
            errorMessage = $"Lỗi phân bổ: {ex.Message}";
        }
        finally
        {
            isCalculating = false;
        }
    }

    private async Task HandleGenerateAiNotice(AllocationResultItem item)
    {
        selectedItemForNotice = item;
        if (batch != null)
        {
            generatedNoticeContent = await GenerateAllocationNoticeUseCase.ExecuteAsync(batch, item, aiWeatherReason);
        }
    }

    private async Task RegenerateNotice()
    {
        if (batch != null && selectedItemForNotice != null)
        {
            generatedNoticeContent = await GenerateAllocationNoticeUseCase.ExecuteAsync(batch, selectedItemForNotice, aiWeatherReason);
        }
    }

    private void ApproveAndSendNotice()
    {
        successMessage = $"Ban Quản trị đã duyệt và gửi thông báo phân bổ cho {selectedItemForNotice?.DealerName} thành công!";
        selectedItemForNotice = null;
    }
}
