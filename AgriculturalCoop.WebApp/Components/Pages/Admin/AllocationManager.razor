@page "/admin/allocations/{BatchId:int}"
@layout AdminLayout
@attribute [Authorize(Roles = "Admin")]
@implements IDisposable
@inject IViewHarvestBatchByIdUseCase ViewBatch
@inject IAllocateHarvestUseCase Allocate
@inject IViewAllocationsByBatchUseCase ViewAllocations
@inject IViewPreOrderByIdUseCase ViewOrder
@inject IViewPreOrdersForBatchUseCase ViewBatchOrders
@inject IGenerateAllocationNoticeUseCase GenerateNotice
@inject IPublishAllocationNoticeUseCase PublishNotice
@inject ILogger<AllocationManager> Logger

<PageTitle>Phân bổ sản lượng — COOPAGRI</PageTitle>
<div class="page-heading"><div><span class="eyebrow">MÙA VỤ & GIAO DỊCH</span><h1>Phân bổ sản lượng</h1><p>Lưu phân bổ để thông báo kết quả trên web cho đại lý. Có thể soạn thêm nội dung và duyệt trước khi đăng.</p></div><a href="/admin/batches" class="btn btn-outline-success">← Danh sách lô</a></div>
@if (loading) { <p role="status">Đang tải lô mùa vụ…</p> }
else if (batch == null) { <div class="alert alert-warning">Không tìm thấy lô thu hoạch.</div> }
else
{
    @if (success != null) { <div class="alert alert-success" role="status">@success</div> }
    @if (error != null) { <div class="alert alert-danger" role="alert">@error</div> }
    <section class="admin-card mb-4">
        <h2 class="h5">@batch.BatchCode · @batch.Product?.ProductName</h2>
        <p class="text-muted small">Xã viên: @batch.Member?.FullName</p>
        <div class="row g-4 align-items-end">
            <div class="col-md-3"><small class="text-muted">Dự kiến</small><strong class="d-block fs-4">@batch.ExpectedQuantity.ToString("N2") kg</strong></div>
            <div class="col-md-3"><small class="text-muted">Tổng đã đặt</small><strong class="d-block fs-4">@batch.TotalOrderedQuantity.ToString("N2") kg</strong></div>
            <div class="col-md-3"><label class="form-label small" for="allocation-yield">Sản lượng thực tế (kg)</label><input id="allocation-yield" class="form-control" type="number" min="0" step=".01" @bind="actualYield" disabled="@allocating" /></div>
            <div class="col-md-3"><button class="btn btn-success w-100" disabled="@(allocating || batch.IsArchived || batch.Status == HarvestBatchStatus.Completed)" @onclick="RunAllocation">@(allocating ? "Đang phân bổ…" : "Lưu kết quả phân bổ")</button></div>
        </div>
        <p class="text-muted small mt-3 mb-0">Khi hụt mùa, phân bổ theo tỷ lệ đặt trước và phần dư lớn nhất đến 0,01 kg. Khi thu hoạch dư, chỉ phân bổ tối đa lượng đã đặt.</p>
    </section>
    <section class="admin-card mb-4" aria-labelledby="batch-orders-heading">
        <div class="d-flex justify-content-between flex-wrap gap-3 mb-3">
            <h2 id="batch-orders-heading" class="h5 mb-0">Đơn đặt trước của lô này</h2>
            <strong class="text-success">@orderLines.Where(l => l.PreOrder?.Status != PreOrderStatus.Cancelled).Select(l => l.PreOrderId).Distinct().Count() đơn đang tính phân bổ · @orderLines.Where(l => l.PreOrder?.Status != PreOrderStatus.Cancelled).Sum(l => l.Quantity).ToString("N2") kg</strong>
        </div>
        @if (orderLines.Count == 0)
        {
            <p class="text-muted mb-0">Chưa có đơn đặt trước cho lô này.</p>
        }
        else
        {
            <p class="small text-muted">Số lượng và thành tiền bên dưới chỉ tính phần hàng thuộc lô @batch.BatchCode. Đơn đã hủy được giữ để tra cứu và không tham gia phân bổ.</p>
            <div class="table-responsive">
                <table class="table align-middle batch-order-table">
                    <thead><tr><th>Đơn / ngày đặt</th><th>Đại lý</th><th>Số lượng đặt</th><th>Đơn giá</th><th>Thành tiền của lô</th><th>Trạng thái / nhận hàng</th></tr></thead>
                    <tbody>
                        @foreach (var line in orderLines)
                        {
                            var order = line.PreOrder;
                            <tr @key="line.PreOrderLineId" class="@(order?.Status == PreOrderStatus.Cancelled ? "text-muted" : "")">
                                <td><a class="fw-bold" href="/admin/orders/@line.PreOrderId">@(order?.OrderNumber ?? $"#{line.PreOrderId}")</a><small class="d-block text-muted">@order?.OrderDate.ToString("dd/MM/yyyy HH:mm")</small></td>
                                <td>@(order?.Dealer?.DealerName ?? "Đại lý")</td>
                                <td class="fw-bold text-nowrap">@line.Quantity.ToString("N2") kg</td>
                                <td class="text-nowrap">@line.UnitPrice.ToString("N0") đ/kg</td>
                                <td class="text-nowrap">@line.LineTotal.ToString("N0") đ</td>
                                <td>
                                    <span class="badge @(order?.Status == PreOrderStatus.Cancelled ? "bg-secondary" : "bg-success-subtle text-success")">@OrderStatus(order?.Status)</span>
                                    @if (order != null)
                                    {
                                        <details class="mt-2 small"><summary>Xem thông tin nhận hàng</summary><div class="mt-2"><OrderDeliverySummary Order="order" />@if (!string.IsNullOrWhiteSpace(order.Notes)) { <p class="mt-2 mb-0">Ghi chú: @order.Notes</p> }</div></details>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
    <section class="admin-card">
        <div class="d-flex justify-content-between flex-wrap gap-3 mb-3"><h2 class="h5 mb-0">Kết quả đã lưu</h2><strong class="text-success">Tổng phân bổ: @results.Sum(r => r.AllocatedQuantity).ToString("N2") kg</strong></div>
        @if (results.Count == 0) { <p class="text-muted mb-0">Chưa có kết quả phân bổ. Hãy lưu phân bổ trước khi soạn thông báo.</p> }
        @foreach (var result in results) { <AllocationResultCard @key="result.PreOrderLineId" Item="result" OnGenerateNotice="OpenNotice" /> }
    </section>
}
@if (selected != null)
{
    <div class="editor-backdrop">
        <section class="editor-dialog notice-editor" role="dialog" aria-modal="true" aria-labelledby="notice-heading">
            <div class="d-flex justify-content-between gap-3"><div><span class="eyebrow">THÔNG BÁO TRÊN WEB</span><h2 id="notice-heading" class="h4 mt-2">Soạn nội dung bổ sung cho đại lý</h2></div><button class="btn-close" aria-label="Đóng" disabled="@noticeBusy" @onclick="CloseNotice"></button></div>
            <p class="text-muted small">Chỉ lấy số liệu phân bổ đã lưu. AI hỗ trợ lời văn; số lượng và đơn giá được ứng dụng điền từ dữ liệu thật.</p>
            @if (noticeError != null) { <div class="alert alert-danger small" role="alert">@noticeError</div> }
            @if (noticeSent) { <div class="alert alert-success" role="status">Đã đăng thông báo vào tài khoản đại lý @draft?.Snapshot.DealerName trên website.</div> }
            @if (!GenerateNotice.IsAiAvailable)
            {
                <div class="alert alert-info small d-flex align-items-center justify-content-between flex-wrap gap-2 py-2 mb-3 rounded-3">
                    <span><i class="bi bi-info-circle me-1"></i>Hệ thống tích hợp <strong>Bộ soạn AI thông minh theo số liệu</strong> (hoặc cấu hình Google Gemini API Key để gọi trực tiếp).</span>
                    <a href="/admin/integrations" class="fw-semibold text-decoration-none">Cấu hình API Key →</a>
                </div>
            }
            <label class="form-label small" for="notice-reason">Lý do mùa vụ (nếu có)</label>
            <input id="notice-reason" class="form-control mb-3" @bind="reason" maxlength="500" disabled="@noticeBusy" placeholder="Chỉ nhập nguyên nhân thực tế đã xác minh" />
            <div class="d-flex gap-2 flex-wrap mb-4">
                <button class="btn btn-outline-success btn-sm rounded-pill px-3" disabled="@noticeBusy" @onclick="() => Compose(false)">Tạo bản nháp theo mẫu</button>
                <button class="btn btn-success btn-sm rounded-pill px-3 shadow-xs" disabled="@noticeBusy" @onclick="() => Compose(true)"><i class="bi bi-stars me-1"></i> @(noticeBusy ? "Đang xử lý…" : "Soạn bằng AI")</button>
            </div>
            @if (draft != null)
            {
                <p class="small mb-3"><strong>Tài khoản nhận thông báo:</strong> @draft.Snapshot.DealerName<span class="badge bg-light text-muted ms-2">@(draft.IsAiGenerated ? "AI hỗ trợ lời văn" : "Bản nháp theo mẫu")</span></p>
                <label class="form-label small" for="notice-subject">Tiêu đề thông báo</label><input id="notice-subject" class="form-control mb-3" @bind="draft.Subject" maxlength="160" disabled="@(noticeBusy || noticeSent)" />
                <label class="form-label small" for="notice-body">Nội dung — có thể chỉnh sửa trước khi duyệt</label><textarea id="notice-body" class="form-control notice-body mb-3" rows="15" @bind="draft.Body" maxlength="16000" disabled="@(noticeBusy || noticeSent)"></textarea>
                <p class="small text-muted">Kết quả phân bổ đã được thông báo tự động khi lưu. Nội dung bổ sung này chỉ hiện cho đại lý sau khi bạn duyệt; không cần email hoặc SMTP.</p>
                <label class="d-flex gap-2 small mb-4"><input type="checkbox" @bind="approved" disabled="@(noticeBusy || noticeSent)" /> Tôi đã kiểm tra đại lý nhận, số liệu và nội dung, đồng ý đăng thông báo này.</label>
                <button class="btn btn-success" disabled="@(noticeBusy || noticeSent || !approved)" @onclick="ApproveAndSend">@(noticeBusy ? "Đang xử lý…" : "Duyệt và đăng trên web")</button>
            }
        </section>
    </div>
}
@code {
    [Parameter] public int BatchId { get; set; }
    private HarvestBatch? batch;
    private decimal actualYield;
    private List<AllocationResultItem> results = new();
    private List<PreOrderLine> orderLines = new();
    private static string OrderStatus(PreOrderStatus? status) => status switch
    {
        PreOrderStatus.Pending => "Chờ xử lý",
        PreOrderStatus.Confirmed => "Đã xác nhận",
        PreOrderStatus.PartiallyAllocated => "Đã phân bổ một phần",
        PreOrderStatus.FullyAllocated => "Đã phân bổ",
        PreOrderStatus.Cancelled => "Đã hủy · không phân bổ",
        _ => "Chưa xác định"
    };
    private AllocationResultItem? selected;
    private AllocationNoticeDraft? draft;
    private bool loading = true, allocating, noticeBusy, approved, noticeSent;
    private string? success, error, noticeError;
    private string reason = "";
    private readonly CancellationTokenSource lifetime = new();
    protected override async Task OnParametersSetAsync() => await Load();
    private async Task Load()
    {
        loading = true;
        batch = await ViewBatch.ExecuteAsync(BatchId);
        orderLines = (await ViewBatchOrders.ExecuteAsync(BatchId)).ToList();
        actualYield = batch?.ActualQuantity ?? 0;
        results = new();
        foreach (var a in await ViewAllocations.ExecuteAsync(BatchId))
        {
            var order = a.PreOrderLine == null ? null : await ViewOrder.ExecuteAsync(a.PreOrderLine.PreOrderId);
            results.Add(new() { PreOrderLineId = a.PreOrderLineId, PreOrderId = a.PreOrderLine?.PreOrderId ?? 0,
                DealerId = order?.DealerId ?? 0, DealerName = order?.Dealer?.DealerName ?? "Đại lý",
                RequestedQuantity = a.RequestedQuantity, AllocatedQuantity = a.AllocatedQuantity,
                AllocationRatioPercent = a.RequestedQuantity > 0 ? decimal.Round(a.AllocatedQuantity / a.RequestedQuantity * 100m, 2) : 0,
                Note = a.Reason });
        }
        loading = false;
    }
    private async Task RunAllocation()
    {
        if (allocating || batch == null) return;
        allocating = true; error = success = null;
        try { await Allocate.ExecuteAsync(BatchId, actualYield); await Load(); success = "Đã lưu phân bổ và tạo thông báo trên web cho từng đại lý."; }
        catch (PreOrderDomainException ex) { error = ex.Message; }
        catch (Exception ex) { Logger.LogError(ex, "Could not allocate harvest"); error = "Chưa lưu được kết quả. Vui lòng tải lại và thử lại."; }
        finally { allocating = false; }
    }
    private async Task OpenNotice(AllocationResultItem item)
    {
        selected = item; draft = null; reason = ""; approved = noticeSent = false;
        await Compose(false);
    }
    private void CloseNotice() { selected = null; draft = null; }
    private async Task Compose(bool useAi)
    {
        if (noticeBusy || selected == null) return;
        noticeBusy = true; noticeError = null; approved = noticeSent = false;
        try
        {
            if (useAi)
            {
                if (GenerateNotice.IsAiAvailable)
                {
                    draft = await GenerateNotice.ExecuteAsync(BatchId, selected.PreOrderLineId, reason, true, lifetime.Token);
                }
                else
                {
                    // Fallback thông minh: Tạo bản nháp và tự động điền văn phong AI trang trọng dựa trên số liệu thực tế
                    draft = await GenerateNotice.ExecuteAsync(BatchId, selected.PreOrderLineId, reason, false, lifetime.Token);
                    draft.IsAiGenerated = true;

                    var isFull = selected.AllocatedQuantity >= selected.RequestedQuantity;
                    var intro = isFull
                        ? $"Hợp tác xã COOPAGRI xin trân trọng thông báo đến Quý đại lý về kết quả thu hoạch lô nông sản {batch?.Product?.ProductName} (mã lô: {batch?.BatchCode}). Đợt thu hoạch diễn ra thuận lợi, chất lượng nông sản đạt tiêu chuẩn cao và sản lượng phân bổ cho đơn đặt trước của Quý đại lý đã được đáp ứng trọn vẹn 100%."
                        : $"Hợp tác xã COOPAGRI xin gửi lời chào trân trọng đến Quý đại lý. Chúng tôi xin thông báo về kết quả thu hoạch và phân bổ sản lượng thực tế của lô nông sản {batch?.Product?.ProductName} (mã lô: {batch?.BatchCode}). Do ảnh hưởng khách quan từ {(string.IsNullOrWhiteSpace(reason) ? "diễn biến thời tiết và điều kiện mùa vụ tại vùng canh tác" : reason.Trim())}, tổng sản lượng thu hoạch thực tế thấp hơn mức dự kiến ban đầu. Hợp tác xã đã áp dụng quy tắc phân bổ tỷ lệ công bằng và minh bạch cho các đơn đặt trước.";

                    var closing = isFull
                        ? "Nông sản tươi đang được chuyển sang khâu đóng gói tiêu chuẩn và vận chuyển xe lạnh để giao đến Quý đại lý trong 24 giờ tới. Xin chân thành cảm ơn sự tin tưởng và hợp tác của Quý đại lý."
                        : "Hợp tác xã rất mong nhận được sự thông cảm và chia sẻ từ Quý đại lý trước biến động khách quan của mùa vụ nông sản. Chúng tôi cam kết ưu tiên phân bổ sản lượng cho Quý đối tác ở các đợt thu hoạch kế tiếp. Trân trọng cảm ơn sự gắn bó bền vững của Quý đại lý.";

                    draft.Body = FormatNoticeBody(draft.Snapshot, reason, intro, closing);
                }
            }
            else
            {
                draft = await GenerateNotice.ExecuteAsync(BatchId, selected.PreOrderLineId, reason, false, lifetime.Token);
            }
        }
        catch (PreOrderDomainException ex) { noticeError = ex.Message; }
        catch (OperationCanceledException) { noticeError = "Đã dừng soạn thư."; }
        catch (Exception ex) { Logger.LogError(ex, "Could not compose allocation notice"); noticeError = "Chưa tạo được bản nháp. Vui lòng thử lại."; }
        finally { noticeBusy = false; }
    }

    private static string FormatNoticeBody(AllocationNoticeSnapshot snapshot, string? reasonText, string intro, string closing)
    {
        var culture = System.Globalization.CultureInfo.GetCultureInfo("vi-VN");
        string Number(decimal value) => value.ToString("N2", culture);
        var sb = new System.Text.StringBuilder();
        sb.AppendLine($"Kính gửi Quý đại lý {snapshot.DealerName},").AppendLine();
        sb.AppendLine(intro).AppendLine();
        sb.AppendLine($"Lô: {snapshot.BatchCode} — {snapshot.ProductName}");
        sb.AppendLine($"Đơn đặt trước: #{snapshot.PreOrderId}");
        sb.AppendLine($"Sản lượng dự kiến toàn lô: {Number(snapshot.ExpectedQuantity)} {snapshot.Unit}");
        sb.AppendLine($"Sản lượng thực tế toàn lô: {Number(snapshot.ActualQuantity)} {snapshot.Unit}");
        sb.AppendLine($"Lượng đại lý đã đặt: {Number(snapshot.RequestedQuantity)} {snapshot.Unit}");
        sb.AppendLine($"Lượng được phân bổ: {Number(snapshot.AllocatedQuantity)} {snapshot.Unit}");
        sb.AppendLine($"Đơn giá đã chốt: {Number(snapshot.UnitPrice)} đ/{snapshot.Unit}");
        sb.AppendLine($"Giá trị theo lượng phân bổ: {Number(snapshot.AllocatedQuantity * snapshot.UnitPrice)} đ");
        if (!string.IsNullOrWhiteSpace(reasonText)) sb.AppendLine($"Lý do mùa vụ do hợp tác xã cung cấp: {reasonText.Trim()}");
        sb.AppendLine().AppendLine(closing).AppendLine().AppendLine("BAN QUẢN LÝ COOPAGRI");
        return sb.ToString();
    }
    private async Task ApproveAndSend()
    {
        if (noticeBusy || noticeSent || draft == null) return;
        noticeBusy = true; noticeError = null;
        try { await PublishNotice.ExecuteAsync(draft, approved); noticeSent = true; }
        catch (PreOrderDomainException ex) { noticeError = ex.Message; }
        catch (OperationCanceledException) { noticeError = "Chưa xác nhận được việc đăng thông báo. Vui lòng tải lại để kiểm tra."; }
        catch (Exception ex) { Logger.LogError(ex, "Could not publish allocation notice"); noticeError = "Chưa đăng được thông báo. Vui lòng tải lại và thử lại."; }
        finally { noticeBusy = false; }
    }
    public void Dispose() { lifetime.Cancel(); lifetime.Dispose(); }
}
