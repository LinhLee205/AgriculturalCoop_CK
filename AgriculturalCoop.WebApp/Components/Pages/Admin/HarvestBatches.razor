@page "/admin/batches"
@layout AdminLayout
@attribute [Authorize(Roles = "Admin")]
@using AgriculturalCoop.WebApp.Models
@inject IViewHarvestBatchesUseCase ViewBatches
@inject IViewMembersUseCase ViewMembers
@inject IViewProductsUseCase ViewProducts
@inject IManageBatchesUseCase ManageBatches
@inject IUpdateActualYieldUseCase UpdateYield
@inject ILogger<HarvestBatches> Logger

<PageTitle>Lô thu hoạch - COOPAGRI</PageTitle>

<div class="page-heading">
    <div>
        <span class="eyebrow">MÙA VỤ & GIAO DỊCH</span>
        <h1>Lô thu hoạch</h1>
        <p>Tạo lô → nhận đặt trước → nhập sản lượng thực → phân bổ.</p>
    </div>
    <button class="btn btn-success" @onclick="() => Open(null)">
        + Tạo lô thu hoạch
    </button>
</div>

@if (message != null)
{
    <div class="alert alert-success" role="status">@message</div>
}

<section class="admin-card mb-4"><div class="row g-3"><div class="col-md-8"><label for="batch-search" class="form-label">Tìm mã lô, nông sản hoặc xã viên</label><input id="batch-search" class="form-control" @bind="search" @bind:event="oninput" /></div><div class="col-md-4"><label for="batch-archive-filter" class="form-label">Hiển thị</label><select id="batch-archive-filter" class="form-select" @bind="archiveFilter"><option value="active">Đang quản lý</option><option value="archived">Đã lưu trữ</option><option value="all">Tất cả</option></select></div></div><p class="small text-muted mt-3 mb-0">Lô có đơn hoặc đã thu hoạch dùng Lưu trữ để giữ lịch sử. Xóa chỉ dành cho lô trống, chưa thu hoạch.</p></section>
<section class="admin-card table-responsive">
    @if (error != null && !editing && yieldBatch == null && deleting == null) { <div class="alert alert-danger" role="alert">@error</div> }
    <table class="table align-middle">
        <thead>
            <tr>
                <th>Lô / nông sản</th>
                <th>Xã viên</th>
                <th>Dự kiến / đã đặt</th>
                <th>Thu hoạch</th>
                <th>Trạng thái</th>
                <th>Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var batch in FilteredBatches)
            {
                <tr>
                    <td>
                        <strong>@batch.BatchCode</strong>
                        <small class="d-block text-muted">
                            @batch.Product?.ProductName ·
                            @batch.UnitPrice.ToString("N0") đ/kg
                        </small>
                    </td>
                    <td>@batch.Member?.FullName</td>
                    <td>
                        @batch.ExpectedQuantity.ToString("N2") kg
                        <small class="d-block text-muted">
                            Đã đặt: @batch.TotalOrderedQuantity.ToString("N2") kg
                        </small>
                        <a class="small" href="/admin/orders?batchId=@batch.HarvestBatchId">@batch.LinkedOrderCount đơn liên quan</a>
                    </td>
                    <td>
                        @batch.ExpectedHarvestDate.ToString("dd/MM/yyyy")
                        <small class="d-block text-muted">
                            Thực tế:
                            @(batch.ActualQuantity?.ToString("N2") ?? "Chưa nhập") kg
                        </small>
                    </td>
                    <td>
                        <span class="badge bg-success-subtle text-success">
                            @Status(batch.Status)
                        </span>
                        @if (batch.IsArchived) { <small class="d-block text-muted">Đã lưu trữ</small> }
                    </td>
                    <td style="min-width: 290px;">
                        <div class="batch-action-toolbar d-flex flex-column gap-2">
                            <!-- Hàng 1: Thao tác cốt lõi vụ mùa -->
                            <div class="d-flex align-items-center gap-2">
                                <a class="btn btn-sm btn-warning rounded-pill px-3 fw-bold flex-fill shadow-xs d-inline-flex align-items-center justify-content-center gap-1"
                                   href="/admin/allocations/@batch.HarvestBatchId" title="Xem danh sách đơn & phân bổ sản lượng">
                                    <i class="bi bi-pie-chart-fill"></i> Đơn / Phân bổ
                                </a>

                                <button class="btn btn-sm btn-outline-primary rounded-pill px-2 shadow-xs d-inline-flex align-items-center justify-content-center gap-1"
                                        disabled="@(busy || batch.IsArchived || batch.Status >= HarvestBatchStatus.Allocated)"
                                        @onclick="() => OpenYield(batch)" title="Cập nhật sản lượng thu hoạch thực tế">
                                    <i class="bi bi-clipboard-check"></i> Nhập thực tế
                                </button>

                                <button class="btn btn-sm btn-outline-secondary rounded-pill px-2 shadow-xs d-inline-flex align-items-center justify-content-center gap-1"
                                        disabled="@(busy || batch.IsArchived || batch.Status >= HarvestBatchStatus.Harvested)"
                                        @onclick="() => Open(batch)" title="Chỉnh sửa thông tin lô">
                                    <i class="bi bi-pencil-square"></i> Sửa
                                </button>
                            </div>

                            <!-- Hàng 2: Trạng thái & Quản trị hồ sơ -->
                            <div class="d-flex align-items-center flex-wrap gap-1">
                                @if (!batch.IsArchived && batch.Status < HarvestBatchStatus.Harvested && batch.ActualQuantity == null)
                                {
                                    <button class="btn btn-sm @(batch.Status == HarvestBatchStatus.OpenForPreOrder ? "btn-outline-warning" : "btn-outline-success") rounded-pill px-2 py-1 shadow-xs d-inline-flex align-items-center gap-1"
                                            style="font-size: 0.78rem;" disabled="@busy" @onclick="() => ToggleOpen(batch)"
                                            title="@(batch.Status == HarvestBatchStatus.OpenForPreOrder ? "Ngừng nhận đơn đặt trước" : "Mở nhận đơn đặt trước trên website")">
                                        <i class="bi @(batch.Status == HarvestBatchStatus.OpenForPreOrder ? "bi-eye-slash" : "bi-eye")"></i>
                                        @(batch.Status == HarvestBatchStatus.OpenForPreOrder ? "Tạm ẩn đặt" : "Mở nhận đặt")
                                    </button>
                                }

                                @if (batch.Status == HarvestBatchStatus.Allocated && !batch.IsArchived)
                                {
                                    <button class="btn btn-sm btn-success rounded-pill px-2 py-1 shadow-xs d-inline-flex align-items-center gap-1"
                                            style="font-size: 0.78rem;" disabled="@busy" @onclick="() => AskAction(batch, true)" title="Hoàn tất giao hàng cho đại lý">
                                        <i class="bi bi-check2-all"></i> Hoàn tất giao
                                    </button>
                                }

                                <button class="btn btn-sm btn-outline-secondary rounded-pill px-2 py-1 shadow-xs d-inline-flex align-items-center gap-1"
                                        style="font-size: 0.78rem;" disabled="@busy" @onclick="() => AskAction(batch, false)"
                                        title="@(batch.IsArchived ? "Khôi phục lô thu hoạch này" : "Lưu trữ lô thu hoạch này")">
                                    <i class="bi @(batch.IsArchived ? "bi-arrow-counterclockwise" : "bi-archive")"></i>
                                    @(batch.IsArchived ? "Khôi phục" : "Lưu trữ")
                                </button>

                                @if (batch.LinkedOrderCount == 0 && batch.Status < HarvestBatchStatus.Harvested)
                                {
                                    <button class="btn btn-sm btn-outline-danger rounded-pill px-2 py-1 shadow-xs d-inline-flex align-items-center gap-1"
                                            style="font-size: 0.78rem;" disabled="@busy" @onclick="() => AskDelete(batch)" title="Xóa lô chưa có đơn này">
                                        <i class="bi bi-trash3"></i> Xóa
                                    </button>
                                }
                            </div>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    @if (!FilteredBatches.Any())
    {
        <p class="text-muted">Không có lô phù hợp với bộ lọc.</p>
    }
</section>

@if (editing)
{
    <div class="editor-backdrop">
        <section class="editor-dialog"
                 role="dialog" aria-modal="true"
                 aria-labelledby="batch-title">
            <div class="d-flex justify-content-between">
                <h2 id="batch-title" class="h5">
                    @(form.HarvestBatchId == 0
                        ? "Tạo lô thu hoạch" : "Sửa lô thu hoạch")
                </h2>

                <button class="btn-close" aria-label="Đóng"
                        disabled="@busy"
                        @onclick="() => editing = false">
                </button>
            </div>

            <EditForm Model="form" OnValidSubmit="Save">
                <DataAnnotationsValidator />

                @if (error != null)
                {
                    <div class="alert alert-danger" role="alert">@error</div>
                }

                <div class="mb-3">
                    <label class="form-label" for="batch-code">Mã lô</label>
                    <InputText id="batch-code" class="form-control"
                               @bind-Value="form.BatchCode" />
                    <ValidationMessage For="@(() => form.BatchCode)" />
                </div>

                <div class="row g-3">
                    <div class="col-sm-6">
                        <label class="form-label" for="batch-member">Xã viên</label>
                        <InputSelect id="batch-member" class="form-select"
                                     @bind-Value="form.MemberId">
                            <option value="0">Chọn xã viên</option>
                            @foreach (var m in members)
                            {
                                <option value="@m.MemberId">@m.FullName</option>
                            }
                        </InputSelect>
                        <ValidationMessage For="@(() => form.MemberId)" />
                    </div>

                    <div class="col-sm-6">
                        <label class="form-label" for="batch-product">Nông sản</label>
                        <InputSelect id="batch-product" class="form-select"
                                     @bind-Value="form.ProductId">
                            <option value="0">Chọn nông sản</option>
                            @foreach (var p in products)
                            {
                                <option value="@p.ProductId">@p.ProductName</option>
                            }
                        </InputSelect>
                        <ValidationMessage For="@(() => form.ProductId)" />
                    </div>
                </div>

                <div class="row g-3 my-1">
                    <div class="col-sm-6">
                        <label class="form-label" for="batch-quantity">
                            Sản lượng dự kiến (kg)
                        </label>
                        <InputNumber id="batch-quantity"
                                     class="form-control"
                                     @bind-Value="form.ExpectedQuantity"
                                     step="0.01" />
                        <ValidationMessage For="@(() => form.ExpectedQuantity)" />
                    </div>

                    <div class="col-sm-6">
                        <label class="form-label" for="batch-price">
                            Đơn giá (đ/kg)
                        </label>
                        <InputNumber id="batch-price" class="form-control"
                                     @bind-Value="form.UnitPrice" />
                        <ValidationMessage For="@(() => form.UnitPrice)" />
                    </div>
                </div>

                <div class="my-3">
                    <label class="form-label" for="batch-date">
                        Ngày thu hoạch dự kiến
                    </label>
                    <InputDate id="batch-date" class="form-control"
                               @bind-Value="form.ExpectedHarvestDate" />
                </div>

                <p class="text-muted small">
                    Lô đã có đơn đặt sẽ khóa xã viên, nông sản và đơn giá.
                    Lô đã thu hoạch giữ nguyên thông tin đã chốt.
                </p>

                <div class="d-flex justify-content-end gap-2">
                    <button type="button" class="btn btn-light"
                            disabled="@busy"
                            @onclick="() => editing = false">
                        Hủy
                    </button>
                    <button type="submit" class="btn btn-success" disabled="@busy">
                        Lưu lô thu hoạch
                    </button>
                </div>
            </EditForm>
        </section>
    </div>
}

@if (yieldBatch != null)
{
    <div class="editor-backdrop">
        <section class="editor-dialog compact"
                 role="dialog" aria-modal="true"
                 aria-labelledby="yield-title">
            <h2 id="yield-title" class="h5">Nhập sản lượng thực tế</h2>
            <p>@yieldBatch.BatchCode</p>

            @if (error != null)
            {
                <div class="alert alert-danger" role="alert">@error</div>
            }

            <label class="form-label" for="actual-yield">Sản lượng (kg)</label>
            <input id="actual-yield"
                   class="form-control mb-4"
                   type="number" min="0" step="0.01"
                   @bind="actualYield" />

            <div class="d-flex justify-content-end gap-2">
                <button class="btn btn-light"
                        disabled="@busy"
                        @onclick="() => yieldBatch = null">
                    Hủy
                </button>
                <button class="btn btn-success"
                        disabled="@busy"
                        @onclick="SaveYield">
                    Lưu sản lượng
                </button>
            </div>
        </section>
    </div>
}

@if (deleting != null)
{
    <ConfirmDelete Name="@deleting.BatchCode"
                   Error="@error" Busy="busy"
                   OnCancel="() => deleting = null"
                   OnConfirm="Delete" />
}

@if (actionBatch != null) { <ConfirmAction Title="@(completing ? "Hoàn tất giao hàng" : actionBatch.IsArchived ? "Khôi phục lô" : "Lưu trữ lô")" Message="@(completing ? "Xác nhận lô đã giao xong. Sau bước này không chạy lại phân bổ." : actionBatch.IsArchived ? "Khôi phục lô vào danh sách quản lý. Lô bị đóng khi lưu trữ cần mở đặt lại nếu muốn nhận đơn mới." : "Ẩn lô khỏi danh sách đang quản lý và ngừng nhận đơn mới. Đơn, phân bổ và lịch sử được giữ nguyên.")" Error="@error" Busy="busy" OnCancel="() => actionBatch = null" OnConfirm="ApplyAction" /> }
@code {
    private List<HarvestBatch> batches = new();
    private List<Member> members = new();
    private List<Product> products = new();
    private BatchForm form = new();
    private HarvestBatch? deleting, yieldBatch;
    private decimal actualYield;
    private bool editing, busy;
    private string? error, message;
    private string search = "", archiveFilter = "active";
    private HarvestBatch? actionBatch;
    private bool completing;
    private IEnumerable<HarvestBatch> FilteredBatches => batches.Where(b => (archiveFilter == "all" || b.IsArchived == (archiveFilter == "archived")) &&
        (search.Trim().Length == 0 || b.BatchCode.Contains(search.Trim(), StringComparison.OrdinalIgnoreCase) ||
        (b.Product?.ProductName.Contains(search.Trim(), StringComparison.OrdinalIgnoreCase) ?? false) || (b.Member?.FullName.Contains(search.Trim(), StringComparison.OrdinalIgnoreCase) ?? false)));
    private void AskAction(HarvestBatch b, bool complete) { actionBatch = b; completing = complete; error = null; }
    private async Task ApplyAction()
    {
        if (busy || actionBatch == null) return; busy = true; error = message = null;
        try
        {
            if (completing) await ManageBatches.CompleteAsync(actionBatch.HarvestBatchId);
            else await ManageBatches.SetArchivedAsync(actionBatch.HarvestBatchId, !actionBatch.IsArchived);
            actionBatch = null; await Load(); message = "Đã cập nhật lô; đơn và kết quả phân bổ được giữ nguyên.";
        }
        catch (PreOrderDomainException ex) { error = ex.Message; }
        catch (Exception ex) { Logger.LogError(ex, "Could not update batch lifecycle"); error = "Chưa cập nhật được lô. Vui lòng thử lại."; }
        finally { busy = false; }
    }

    protected override async Task OnInitializedAsync()
    {
        await Load();
        members = (await ViewMembers.ExecuteAsync()).ToList();
        products = (await ViewProducts.ExecuteAsync()).ToList();
    }

    private async Task Load() =>
        batches = (await ViewBatches.ExecuteAsync()).ToList();

    private async Task ToggleOpen(HarvestBatch batch)
    {
        if (busy) return;
        busy = true; error = message = null;
        try
        {
            var isOpen = batch.Status != HarvestBatchStatus.OpenForPreOrder;
            await ManageBatches.SetOpenAsync(batch.HarvestBatchId, isOpen);
            message = isOpen ? "Đã mở đặt và hiển thị lô trên trang khách hàng." : "Đã ẩn lô khỏi trang khách hàng và ngừng nhận đơn mới. Các đơn đã đặt vẫn được giữ lại.";
            await Load();
        }
        catch (PreOrderDomainException ex) { error = ex.Message; }
        finally { busy = false; }
    }

    private void Open(HarvestBatch? batch)
    {
        form = batch == null ? new() : BatchForm.From(batch);
        editing = true;
        error = null;
    }

    private void AskDelete(HarvestBatch batch)
    {
        deleting = batch;
        error = null;
    }

    private void OpenYield(HarvestBatch batch)
    {
        yieldBatch = batch;
        actualYield = batch.ActualQuantity ?? 0;
        error = null;
    }

    private static string Status(HarvestBatchStatus status) => status switch
    {
        HarvestBatchStatus.OpenForPreOrder => "Đang mở đặt",
        HarvestBatchStatus.Harvested => "Đã thu hoạch",
        HarvestBatchStatus.Allocated => "Đã phân bổ",
        HarvestBatchStatus.Completed => "Hoàn tất",
        _ => "Dự kiến"
    };

    private async Task Save()
    {
        if (busy) return;
        busy = true;
        error = null;

        try
        {
            await ManageBatches.SaveAsync(form.ToEntity());
            editing = false;
            message = "Đã lưu lô thu hoạch.";
            await Load();
        }
        catch (PreOrderDomainException ex)
        {
            error = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private async Task Delete()
    {
        if (busy || deleting == null) return;
        busy = true;
        error = null;

        try
        {
            await ManageBatches.DeleteAsync(deleting.HarvestBatchId);
            deleting = null;
            message = "Đã xóa lô thu hoạch.";
            await Load();
        }
        catch (PreOrderDomainException ex)
        {
            error = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private async Task SaveYield()
    {
        if (busy || yieldBatch == null) return;
        busy = true;
        error = null;

        try
        {
            await UpdateYield.ExecuteAsync(
                yieldBatch.HarvestBatchId, actualYield, DateTime.Now);

            yieldBatch = null;
            message = "Đã nhập sản lượng. Bạn có thể chạy phân bổ tại lô này.";
            await Load();
        }
        catch (PreOrderDomainException ex)
        {
            error = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }
}
