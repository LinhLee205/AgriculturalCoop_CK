@page "/admin"
@layout AdminLayout
@attribute [Authorize(Roles = "Admin")]
@inject IViewMembersUseCase ViewMembers
@inject IViewProductsUseCase ViewProducts
@inject IViewHarvestBatchesUseCase ViewBatches
@inject IViewAllPreOrdersUseCase ViewOrders
@inject IViewMemberRevenueUseCase ViewRevenue

<PageTitle>Bảng điều khiển - COOPAGRI</PageTitle>

<div class="page-heading">
    <div>
        <span class="eyebrow">TỔNG QUAN</span>
        <h1>Bảng điều khiển</h1>
        <p>Theo dõi danh mục, mùa vụ và giá trị nông sản đã phân bổ.</p>
    </div>
</div>

<div class="dashboard-grid">
    <a href="/admin/members" class="stat-card">
        <span>Xã viên</span>
        <strong>@memberCount</strong>
        <small>Hộ tham gia hợp tác xã</small>
    </a>

    <a href="/admin/products" class="stat-card">
        <span>Nông sản</span>
        <strong>@productCount</strong>
        <small>Danh mục sản phẩm</small>
    </a>

    <a href="/admin/batches" class="stat-card">
        <span>Lô đang mở đặt</span>
        <strong>@openCount</strong>
        <small>Nhận đơn từ đại lý</small>
    </a>

    <a href="/admin/orders" class="stat-card">
        <span>Đơn đặt trước</span>
        <strong>@orderCount</strong>
        <small>Đơn đã ghi nhận</small>
    </a>
</div>

<div class="row g-4 mt-1">
    <div class="col-lg-7">
        <section class="admin-card">
            <h2 class="h5">Quy trình quản lý mùa vụ</h2>
            <ol class="workflow-list">
                <li>
                    <a href="/admin/members">Quản lý xã viên</a> và
                    <a href="/admin/products">danh mục nông sản</a>.
                </li>
                <li>
                    <a href="/admin/batches">Tạo lô thu hoạch</a>,
                    nhập sản lượng dự kiến và mở nhận đặt trước.
                </li>
                <li>
                    <a href="/admin/orders">Theo dõi đơn</a>,
                    nhập sản lượng thực tế rồi chạy phân bổ ở từng lô.
                </li>
                <li>
                    <a href="/admin/revenue">
                        Đối chiếu doanh thu theo xã viên
                    </a>.
                </li>
            </ol>
        </section>
    </div>

    <div class="col-lg-5">
        <section class="admin-card">
            <h2 class="h5">Giá trị mùa vụ</h2>
            <p class="text-muted small">
                Giá trị theo lượng phân bổ, chưa phải tiền đã thu.
            </p>

            <div class="revenue-total">
                @allocatedAmount.ToString("N0") <small>đ</small>
            </div>

            <hr />

            <div class="d-flex justify-content-between">
                <span>Giá trị đặt trước</span>
                <strong>@committedAmount.ToString("N0") đ</strong>
            </div>

            <a href="/admin/revenue" class="btn btn-outline-success mt-4">
                Xem theo xã viên
            </a>
        </section>
    </div>
</div>

@code {
    private int memberCount, productCount, openCount, orderCount;
    private decimal allocatedAmount, committedAmount;

    protected override async Task OnInitializedAsync()
    {
        memberCount = (await ViewMembers.ExecuteAsync()).Count();
        productCount = (await ViewProducts.ExecuteAsync()).Count();

        openCount = (await ViewBatches.ExecuteAsync())
            .Count(b => b.Status == HarvestBatchStatus.OpenForPreOrder);

        orderCount = (await ViewOrders.ExecuteAsync()).Count();

        var revenue = await ViewRevenue.ExecuteAsync(null, null);
        allocatedAmount = revenue.Sum(r => r.AllocatedAmount);
        committedAmount = revenue.Sum(r => r.CommittedAmount);
    }
}
