@page "/admin"
@inject UserSessionState UserSession
@inject NavigationManager Nav
@inject IViewMembersUseCase ViewMembersUseCase
@inject IViewProductsUseCase ViewProductsUseCase
@inject IViewHarvestBatchesUseCase ViewHarvestBatchesUseCase
@inject IViewAllPreOrdersUseCase ViewAllPreOrdersUseCase

@attribute [StreamRendering(false)]
@page "/admin/login"

<PageTitle>@(UserSession.IsAdmin ? "Bảng Điều Khiển Quản Trị - HTX Nông Nghiệp" : "Đăng Nhập Quản Trị - HTX Nông Nghiệp")</PageTitle>

@if (!UserSession.IsAdmin)
{
    <div class="row justify-content-center align-items-center py-4 my-2">
        <div class="col-12 col-md-8 col-lg-5 col-xl-4">
            <div class="card border-0 rounded-4 shadow-lg overflow-hidden bg-white">
                <!-- Header Banner -->
                <div class="p-4 text-center text-white" style="background: linear-gradient(135deg, #064e3b 0%, #065f46 50%, #0f172a 100%);">
                    <div class="bg-warning text-dark rounded-circle p-3 d-inline-flex align-items-center justify-content-center shadow-sm mb-3" style="width: 64px; height: 64px;">
                        <i class="bi bi-shield-lock-fill fs-2"></i>
                    </div>
                    <h4 class="fw-bold mb-1">CỔNG QUẢN TRỊ HTX</h4>
                    <p class="text-white-50 small mb-0">Hệ thống Đặt trước & Phân bổ Nông sản Theo Mùa vụ</p>
                </div>

                <!-- Form Body -->
                <div class="card-body p-4 p-md-4">
                    <div class="text-center mb-3">
                        <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-1 rounded-pill small fw-semibold">
                            XÁC THỰC BẢO MẬT (K4.1 / K4.2)
                        </span>
                    </div>

                    @if (!string.IsNullOrEmpty(loginErrorMessage))
                    {
                        <div class="alert alert-danger py-2 px-3 small rounded-3 d-flex align-items-center gap-2 mb-3 shadow-xs">
                            <i class="bi bi-exclamation-triangle-fill fs-5 text-danger flex-shrink-0"></i>
                            <div>@loginErrorMessage</div>
                        </div>
                    }

                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-secondary">Tài khoản Quản trị</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0 text-muted">
                                <i class="bi bi-person-badge"></i>
                            </span>
                            <input type="text" 
                                   class="form-control border-start-0 ps-1" 
                                   placeholder="Nhập 'admin' hoặc email..." 
                                   @bind="loginUsername" 
                                   @bind:event="oninput" 
                                   @onkeydown="HandleKeyDown" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-secondary">Mật khẩu</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0 text-muted">
                                <i class="bi bi-key-fill"></i>
                            </span>
                            <input type="@(showPassword ? "text" : "password")" 
                                   class="form-control border-start-0 border-end-0 ps-1" 
                                   placeholder="Nhập mật khẩu quản trị..." 
                                   @bind="loginPassword" 
                                   @bind:event="oninput" 
                                   @onkeydown="HandleKeyDown" />
                            <button class="btn btn-outline-secondary border-start-0 px-3 bg-light" 
                                    type="button" 
                                    @onclick="TogglePasswordVisibility" 
                                    title="@(showPassword ? "Ẩn mật khẩu" : "Hiện mật khẩu")">
                                <i class="bi @(showPassword ? "bi-eye-slash-fill text-success" : "bi-eye-fill text-muted")"></i>
                            </button>
                        </div>
                    </div>

                    <button class="btn btn-success w-100 fw-bold py-2 rounded-3 shadow-sm mt-2 d-flex align-items-center justify-content-center gap-2" 
                            @onclick="HandleLogin">
                        <i class="bi bi-box-arrow-in-right fs-5"></i>
                        <span>Đăng Nhập Quản Trị</span>
                    </button>

                    <!-- Hộp Gợi Ý Tài Khoản Phục Vụ Chấm Thi / Vấn Đáp -->
                    <div class="mt-4 p-3 bg-light rounded-3 border small text-muted">
                        <div class="d-flex align-items-center gap-1 text-success fw-bold mb-1">
                            <i class="bi bi-info-circle-fill"></i>
                            <span>Thông tin tài khoản Demo:</span>
                        </div>
                        <div class="d-flex justify-content-between mb-1">
                            <span>Tên đăng nhập:</span>
                            <strong class="text-dark">admin</strong>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span>Mật khẩu:</span>
                            <strong class="text-dark">admin123</strong>
                        </div>
                    </div>

                    <div class="text-center mt-3">
                        <a href="/" class="text-muted small text-decoration-none">
                            <i class="bi bi-arrow-left me-1"></i> Quay về Trang chủ
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="mb-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <span class="badge bg-warning text-dark px-3 py-1 rounded-pill fw-bold mb-2">QUẢN TRỊ VIÊN HTX</span>
                <h2 class="fw-bold text-dark mb-1">Bảng Điều Khiển Hợp Tác Xã</h2>
                <p class="text-muted small mb-0">Theo dõi tổng thể các hộ xã viên, tiến độ mùa vụ và điều phối phân bổ</p>
            </div>
            <div class="d-flex gap-2">
                <a href="/admin/batches" class="btn btn-warning text-dark fw-bold rounded-pill px-3 shadow-sm">
                    <i class="bi bi-box-seam me-1"></i> Quản lý Lô & Phân bổ
                </a>
                <button class="btn btn-outline-danger rounded-pill px-3 shadow-sm fw-semibold" @onclick="Logout">
                    <i class="bi bi-box-arrow-right me-1"></i> Đăng xuất
                </button>
            </div>
        </div>

        <!-- 4 Thẻ KPI Thống Kê -->
        <div class="row g-3 mb-4">
            <div class="col-sm-6 col-lg-3">
                <div class="card border-0 rounded-4 shadow-sm p-3 bg-white h-100">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="text-muted small fw-semibold">Tổng Hộ Xã Viên</span>
                        <div class="bg-success-subtle text-success p-2 rounded-3">
                            <i class="bi bi-people-fill fs-5"></i>
                        </div>
                    </div>
                    <h3 class="fw-bold text-dark mb-0">@membersCount</h3>
                    <small class="text-muted">Liên kết tiêu chuẩn VietGAP</small>
                </div>
            </div>

            <div class="col-sm-6 col-lg-3">
                <div class="card border-0 rounded-4 shadow-sm p-3 bg-white h-100">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="text-muted small fw-semibold">Lô Thu Hoạch</span>
                        <div class="bg-warning-subtle text-warning p-2 rounded-3">
                            <i class="bi bi-box-seam fs-5"></i>
                        </div>
                    </div>
                    <h3 class="fw-bold text-dark mb-0">@batchesCount</h3>
                    <small class="text-muted">Đang canh tác & mở đặt trước</small>
                </div>
            </div>

            <div class="col-sm-6 col-lg-3">
                <div class="card border-0 rounded-4 shadow-sm p-3 bg-white h-100">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="text-muted small fw-semibold">Đơn Đặt Trước Sỉ</span>
                        <div class="bg-primary-subtle text-primary p-2 rounded-3">
                            <i class="bi bi-receipt fs-5"></i>
                        </div>
                    </div>
                    <h3 class="fw-bold text-dark mb-0">@ordersCount</h3>
                    <small class="text-muted">Từ hệ thống đại lý bao tiêu</small>
                </div>
            </div>

            <div class="col-sm-6 col-lg-3">
                <div class="card border-0 rounded-4 shadow-sm p-3 bg-white h-100">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="text-muted small fw-semibold">Giá Trị Bao Tiêu</span>
                        <div class="bg-danger-subtle text-danger p-2 rounded-3">
                            <i class="bi bi-currency-dollar fs-5"></i>
                        </div>
                    </div>
                    <h3 class="fw-bold text-dark mb-0">@(totalRevenue.ToString("N0")) <small class="fs-6 text-muted font-normal">đ</small></h3>
                    <small class="text-muted">Doanh số cam kết mùa vụ</small>
                </div>
            </div>
        </div>

        <!-- Quick Actions & Giới thiệu Demo Nghiệp vụ -->
        <div class="row g-4">
            <div class="col-lg-8">
                <div class="card border-0 rounded-4 shadow-sm p-4 bg-white mb-4">
                    <h5 class="fw-bold text-dark mb-3">
                        <i class="bi bi-diagram-3-fill text-success me-2"></i> Luồng Nghiệp Vụ Cốt Lõi Cần Vấn Đáp
                    </h5>
                    
                    <div class="p-3 rounded-3 bg-light border mb-3">
                        <strong class="text-dark d-block mb-1">Ca Demo Lô Thanh trà Lô 001 (Theo Đề Bài Capstone):</strong>
                        <ul class="mb-0 small text-muted ps-3">
                            <li>Dự kiến thu hoạch ban đầu: <strong>1.000 kg</strong></li>
                            <li>Đại lý A đặt: <strong>400 kg</strong> | Đại lý B đặt: <strong>300 kg</strong> | Đại lý C đặt: <strong>200 kg</strong> (Tổng = 900 kg &le; 1.000 kg &rarr; Đạt Luật 1)</li>
                            <li>Thu hoạch thực tế thực tế bị thiếu hụt: <strong>720 kg</strong></li>
                            <li>Kích hoạt thuật toán phân bổ theo tỷ lệ (Luật 2): A nhận 320 kg, B nhận 240 kg, C nhận 160 kg (Tổng = 720 kg khớp 100%).</li>
                        </ul>
                    </div>

                    <a href="/admin/allocations/1" class="btn btn-warning text-dark fw-bold rounded-pill px-4">
                        <i class="bi bi-play-circle-fill me-1"></i> Mở Màn Hình Chạy Phân Bổ Lô 001 Ngay
                    </a>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card border-0 rounded-4 shadow-sm p-4 bg-white">
                    <h5 class="fw-bold text-dark mb-3">Phím Tắt Quản Trị</h5>
                    <div class="d-grid gap-2">
                        <a href="/admin/batches" class="btn btn-outline-success rounded-3 text-start p-3">
                            <i class="bi bi-box-seam me-2"></i> Quản lý Lô Mùa Vụ
                        </a>
                        <a href="/admin/orders" class="btn btn-outline-primary rounded-3 text-start p-3">
                            <i class="bi bi-card-checklist me-2"></i> Danh Sách Đơn Đặt Trước
                        </a>
                        <a href="/admin/members" class="btn btn-outline-secondary rounded-3 text-start p-3">
                            <i class="bi bi-people me-2"></i> Danh Sách Hộ Xã Viên
                        </a>
                        <a href="/admin/products" class="btn btn-outline-secondary rounded-3 text-start p-3">
                            <i class="bi bi-egg-fried me-2"></i> Danh Mục Nông Sản
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private int membersCount = 0;
    private int batchesCount = 0;
    private int ordersCount = 0;
    private decimal totalRevenue = 0;

    // Quản lý trạng thái form Đăng nhập Quản trị
    private string loginUsername = "admin";
    private string loginPassword = "";
    private bool showPassword = false;
    private string? loginErrorMessage = null;

    protected override async Task OnInitializedAsync()
    {
        if (UserSession.IsAdmin)
        {
            await LoadDashboardData();
        }
    }

    private async Task LoadDashboardData()
    {
        var members = await ViewMembersUseCase.ExecuteAsync();
        membersCount = members.Count();

        var batches = await ViewHarvestBatchesUseCase.ExecuteAsync();
        batchesCount = batches.Count();

        var orders = await ViewAllPreOrdersUseCase.ExecuteAsync();
        ordersCount = orders.Count();
        totalRevenue = orders.Sum(o => o.TotalAmount);
    }

    private void TogglePasswordVisibility()
    {
        showPassword = !showPassword;
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await HandleLogin();
        }
    }

    private async Task HandleLogin()
    {
        if (UserSession.TryLoginAdmin(loginUsername, loginPassword, out var err))
        {
            loginErrorMessage = null;
            await LoadDashboardData();
            StateHasChanged();
        }
        else
        {
            loginErrorMessage = err;
        }
    }

    private void Logout()
    {
        UserSession.LogoutAdmin();
        loginPassword = "";
        loginErrorMessage = null;
        Nav.NavigateTo("/", forceLoad: false);
    }
}
