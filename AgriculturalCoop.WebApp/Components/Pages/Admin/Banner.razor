@page "/admin/banner"
@layout AdminLayout
@attribute [Authorize(Roles = "Admin")]
@using AgriculturalCoop.UseCases.PluginInterfaces
@using AgriculturalCoop.WebApp.Services
@inject IHomeBannerUseCases Banners
@inject IProductImageStore Images
@inject ILogger<Banner> Logger

<PageTitle>Banner & Logo Website — COOPAGRI</PageTitle>

<div class="page-heading">
    <div>
        <span class="eyebrow">GIAO DIỆN CỬA HÀNG</span>
        <h1>Banner & Logo Website</h1>
        <p>Tùy chỉnh biểu tượng logo, tên thương hiệu, banner trang chủ và ảnh giới thiệu nông sản sạch chính hãng.</p>
    </div>
    <a class="btn btn-outline-success rounded-pill px-3" href="/" target="_blank" rel="noopener noreferrer">
        <i class="bi bi-box-arrow-up-right me-1"></i> Xem website chính
    </a>
</div>

@if (loading)
{
    <div class="text-center py-5">
        <div class="spinner-border text-success" role="status"></div>
        <p class="text-muted mt-2">Đang tải cấu hình giao diện…</p>
    </div>
}
else
{
    @if (message != null)
    {
        <div class="alert alert-success d-flex align-items-center mb-4 rounded-4" role="status">
            <i class="bi bi-check-circle-fill fs-5 me-2"></i>
            <div>@message</div>
        </div>
    }

    <EditForm Model="form" OnValidSubmit="Save">
        <DataAnnotationsValidator />
        <ValidationSummary />

        @if (error != null)
        {
            <div class="alert alert-danger mb-4 rounded-4" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-1"></i> @error
            </div>
        }

        <div class="row g-4">
            <!-- CỘT 1: FORM CẤU HÌNH LOGO, BANNER VÀ ẢNH GIỚI THIỆU -->
            <div class="col-lg-7">
                <!-- 1. CẤU HÌNH LOGO THƯƠNG HIỆU -->
                <section class="admin-card mb-4" style="border-left: 4px solid #16a34a;">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <i class="bi bi-award fs-4 text-success"></i>
                        <h2 class="h5 mb-0 fw-bold">1. Logo & Thương hiệu Website</h2>
                    </div>
                    <p class="small text-muted mb-3">
                        Logo và tên thương hiệu sẽ hiển thị tại thanh điều hướng chính (Top Navbar) và chân trang (Footer) trên toàn bộ website.
                    </p>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label for="brand-name" class="form-label small fw-semibold">Tên thương hiệu / HTX</label>
                            <InputText id="brand-name" class="form-control" @bind-Value="form.BrandName" maxlength="100" placeholder="VD: COOPAGRI" />
                        </div>
                        <div class="col-md-6">
                            <label for="brand-tagline" class="form-label small fw-semibold">Khẩu hiệu / Tagline</label>
                            <InputText id="brand-tagline" class="form-control" @bind-Value="form.BrandTagline" maxlength="150" placeholder="VD: Nông sản sạch theo mùa" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="brand-logo-file" class="form-label small fw-semibold">Ảnh Logo (Tùy chọn)</label>
                        <InputFile @key="logoUploadKey" id="brand-logo-file" class="form-control" OnChange="SelectLogo"
                                   accept="image/png,image/jpeg,image/webp,image/svg+xml" disabled="@busy" />
                        <small class="text-muted d-block mt-1">Gợi ý logo ngang hoặc vuông nền trong suốt (PNG, SVG, WebP), tối đa 5 MB.</small>

                        @if (logoFile != null)
                        {
                            <div class="small text-success mt-1">
                                <i class="bi bi-check2"></i> Đã chọn file logo: <strong>@logoFile.Name</strong>. Ảnh sẽ cập nhật khi bấm Lưu.
                            </div>
                        }

                        <div class="d-flex gap-2 mt-2">
                            @if (!string.IsNullOrEmpty(form.LogoUrl) || logoFile != null)
                            {
                                <button type="button" class="btn btn-outline-danger btn-sm rounded-pill" disabled="@busy" @onclick="ResetLogo">
                                    <i class="bi bi-trash me-1"></i>Dùng biểu tượng lá mặc định (🌿)
                                </button>
                            }
                        </div>
                    </div>
                </section>

                <!-- 2. CẤU HÌNH BANNER TRANG CHỦ -->
                <section class="admin-card mb-4" style="border-left: 4px solid #2563eb;">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <i class="bi bi-image fs-4 text-primary"></i>
                        <h2 class="h5 mb-0 fw-bold">2. Banner Đầu Trang Chủ</h2>
                    </div>

                    <div class="mb-3">
                        <label for="banner-eyebrow" class="form-label small fw-semibold">Dòng giới thiệu (Eyebrow)</label>
                        <InputText id="banner-eyebrow" class="form-control" @bind-Value="form.Eyebrow" maxlength="60" />
                    </div>

                    <div class="mb-3">
                        <label for="banner-title" class="form-label small fw-semibold">Tiêu đề chính của banner</label>
                        <InputText id="banner-title" class="form-control" @bind-Value="form.Title" maxlength="140" />
                    </div>

                    <div class="mb-3">
                        <label for="banner-description" class="form-label small fw-semibold">Đoạn mô tả</label>
                        <InputTextArea id="banner-description" class="form-control" rows="3" @bind-Value="form.Description" maxlength="400" />
                    </div>

                    <div class="mb-3">
                        <label for="banner-image" class="form-label small fw-semibold">Ảnh nền Banner</label>
                        <InputFile @key="uploadKey" id="banner-image" class="form-control" OnChange="SelectImage"
                                   accept="image/png,image/jpeg,image/webp" disabled="@busy" />
                        <small class="text-muted d-block mt-1">Ảnh ngang, gợi ý 1600 × 600 px. PNG, JPEG hoặc WebP, tối đa 5 MB.</small>
                        @if (file != null)
                        {
                            <div class="small text-success mt-1">
                                <i class="bi bi-check2"></i> Đã chọn file banner: <strong>@file.Name</strong>.
                            </div>
                        }
                        <button type="button" class="btn btn-link btn-sm px-0 mt-1" disabled="@busy" @onclick="ResetImage">
                            Dùng ảnh banner mẫu mặc định
                        </button>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label for="banner-button" class="form-label small fw-semibold">Chữ trên nút</label>
                            <InputText id="banner-button" class="form-control" @bind-Value="form.ButtonText" maxlength="40" />
                        </div>
                        <div class="col-md-6">
                            <label for="banner-link" class="form-label small fw-semibold">Đường dẫn liên kết</label>
                            <InputText id="banner-link" class="form-control" @bind-Value="form.ButtonUrl" maxlength="200" />
                        </div>
                    </div>
                </section>

                <!-- 3. CẤU HÌNH ẢNH GIỚI THIỆU NHÀ PHÂN PHỐI CHÍNH HÃNG (Yêu cầu ảnh 1) -->
                <section class="admin-card mb-4" style="border-left: 4px solid #ea580c;">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <i class="bi bi-basket3 fs-4 text-warning"></i>
                        <h2 class="h5 mb-0 fw-bold">3. Ảnh Giới Thiệu "Nhà Phân Phối Chính Hãng" (Trang Chủ)</h2>
                    </div>
                    <p class="small text-muted mb-3">
                        Hình ảnh thực tế trưng bày các loại nông sản tươi sạch nằm trong khung "NHÀ PHÂN PHỐI CHÍNH HÃNG" (bên cạnh các chứng nhận VietGAP, GlobalGAP, OCOP 5★).
                    </p>

                    <div class="mb-3">
                        <label for="intro-image" class="form-label small fw-semibold">Tải lên ảnh thực tế mới (PNG, JPG, WebP, SVG)</label>
                        <InputFile @key="introUploadKey" id="intro-image" class="form-control" OnChange="SelectIntroImage"
                                   accept="image/png,image/jpeg,image/webp,image/svg+xml" disabled="@busy" />
                        <small class="text-muted d-block mt-1">Khuyên dùng ảnh chụp giỏ nông sản thật độ phân giải cao hoặc vector nền sáng, tối đa 5 MB.</small>
                        @if (introFile != null)
                        {
                            <div class="small text-success mt-1">
                                <i class="bi bi-check2"></i> Đã chọn file ảnh giới thiệu: <strong>@introFile.Name</strong>. Bấm Lưu để cập nhật.
                            </div>
                        }
                        <button type="button" class="btn btn-link btn-sm px-0 mt-1" disabled="@busy" @onclick="ResetIntroImage">
                            Dùng ảnh thực tế mẫu mặc định (Giỏ nông sản sạch COOPAGRI)
                        </button>
                    </div>
                </section>

                <div class="mb-4">
                    <button type="submit" class="btn btn-success btn-lg rounded-pill px-5 shadow-sm" disabled="@busy">
                        <i class="bi bi-floppy me-1"></i> @(busy ? "Đang lưu thay đổi…" : "Lưu toàn bộ thay đổi Giao diện")
                    </button>
                </div>
            </div>

            <!-- CỘT 2: KHUNG XEM TRƯỚC (PREVIEW PANEL) -->
            <div class="col-lg-5">
                <div class="sticky-top" style="top: 20px;">
                    <!-- XEM TRƯỚC LOGO TRÊN NAVBAR -->
                    <section class="admin-card mb-4">
                        <span class="eyebrow text-success">XEM TRƯỚC LOGO TRÊN WEBSITE</span>
                        <h3 class="h6 fw-bold mb-3">Hiển thị thực tế trên thanh Menu:</h3>

                        <div class="p-3 rounded-4 shadow-sm" style="background: linear-gradient(135deg, #1b4332 0%, #24583f 100%);">
                            <div class="d-flex align-items-center justify-content-between">
                                <div class="d-inline-flex align-items-center gap-2">
                                    @if (!string.IsNullOrEmpty(form.LogoUrl))
                                    {
                                        <img src="@form.LogoUrl" alt="Logo preview" style="height: 40px; max-width: 120px; object-fit: contain; border-radius: 8px; background: rgba(255,255,255,0.2); padding: 2px 4px;" />
                                    }
                                    else
                                    {
                                        <span style="font-size: 1.6rem;">🌿</span>
                                    }
                                    <div class="d-flex flex-column text-white">
                                        <strong style="font-size: 1.15rem; font-weight: 850; line-height: 1.1;">
                                            @(string.IsNullOrWhiteSpace(form.BrandName) ? "COOPAGRI" : form.BrandName)
                                        </strong>
                                        <small style="font-size: 0.65rem; color: #bbf7d0; text-transform: uppercase; letter-spacing: 0.05em;">
                                            @(string.IsNullOrWhiteSpace(form.BrandTagline) ? "Nông sản sạch theo mùa" : form.BrandTagline)
                                        </small>
                                    </div>
                                </div>

                                <div class="badge rounded-pill bg-white text-dark px-2 py-1 small">
                                    Menu Preview
                                </div>
                            </div>
                        </div>
                    </section>

                    <!-- XEM TRƯỚC ẢNH GIỚI THIỆU NHÀ PHÂN PHỐI CHÍNH HÃNG -->
                    <section class="admin-card mb-4">
                        <span class="eyebrow text-warning">XEM TRƯỚC KHUNG GIỚI THIỆU (ẢNH 1)</span>
                        <h3 class="h6 fw-bold mb-2">Ảnh thực tế "Nhà Phân Phối Chính Hãng":</h3>
                        <div class="p-3 bg-light rounded-4 border text-center">
                            <img src="@(string.IsNullOrWhiteSpace(form.IntroImageUrl) ? "/images/showcase-farm-produce.svg" : form.IntroImageUrl)" 
                                 alt="Showcase preview" 
                                 style="max-height: 130px; max-width: 100%; object-fit: contain; border-radius: 8px;"
                                 onerror="this.onerror=null;this.src='/images/showcase-farm-produce.svg'" />
                            <div class="d-flex align-items-center justify-content-between pt-2 mt-2 border-top">
                                <span class="badge bg-success-subtle text-success rounded-pill px-2 py-0-5 font-monospace" style="font-size: 0.7rem;">VietGAP</span>
                                <span class="badge bg-primary-subtle text-primary rounded-pill px-2 py-0-5 font-monospace" style="font-size: 0.7rem;">GlobalGAP</span>
                                <span class="badge bg-warning-subtle text-dark rounded-pill px-2 py-0-5 font-monospace" style="font-size: 0.7rem;">OCOP 5★</span>
                            </div>
                        </div>
                        <small class="text-muted d-block mt-2">
                            Khung này hiển thị trực tiếp ở phần giới thiệu trang chủ.
                        </small>
                    </section>

                    <!-- XEM TRƯỚC BANNER TRANG CHỦ -->
                    <section class="admin-card">
                        <span class="eyebrow text-primary">XEM TRƯỚC BANNER TRANG CHỦ</span>
                        <h3 class="h6 fw-bold mb-2">Giao diện Banner:</h3>
                        <div class="rounded-3 overflow-hidden shadow-sm">
                            <div class="store-banner p-3 text-white" style="background-image: url('@form.ImageUrl'); background-size: cover; background-position: center; border-radius: 12px; min-height: 130px;">
                                <div class="bg-dark bg-opacity-50 p-2 rounded-3" style="backdrop-filter: blur(2px);">
                                    <span class="badge bg-success-subtle text-success rounded-pill mb-1" style="font-size: 0.7rem;">@form.Eyebrow</span>
                                    <h4 class="h6 fw-bold text-white mb-1">@form.Title</h4>
                                    <p class="small text-white-50 mb-2" style="font-size: 0.75rem; line-height: 1.3;">@form.Description</p>
                                    <button class="btn btn-success btn-sm rounded-pill px-3 py-1" style="font-size: 0.75rem;" disabled>@form.ButtonText →</button>
                                </div>
                            </div>
                        </div>
                    </section>
                </div>
            </div>
        </div>
    </EditForm>
}

@code {
    private HomeBanner form = new();
    private bool loading = true;
    private bool busy;
    private string? message;
    private string? error;
    private IBrowserFile? file;
    private IBrowserFile? logoFile;
    private IBrowserFile? introFile;
    private Guid uploadKey = Guid.NewGuid();
    private Guid logoUploadKey = Guid.NewGuid();
    private Guid introUploadKey = Guid.NewGuid();
    private string previousBannerImage = "";
    private string previousLogoImage = "";
    private string previousIntroImage = "";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            form = await Banners.GetAsync();
            previousBannerImage = form.ImageUrl;
            previousLogoImage = form.LogoUrl ?? "";
            previousIntroImage = form.IntroImageUrl ?? "";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Could not load banner settings");
            error = "Không tải được cấu hình banner.";
        }
        finally
        {
            loading = false;
        }
    }

    private void SelectLogo(InputFileChangeEventArgs args)
    {
        logoFile = args.File;
        error = logoFile.Size > ProductImageStore.MaxBytes ? "Ảnh logo vượt quá 5 MB." : null;
        message = null;
    }

    private void ResetLogo()
    {
        logoFile = null;
        logoUploadKey = Guid.NewGuid();
        form.LogoUrl = null;
        error = message = null;
    }

    private void SelectImage(InputFileChangeEventArgs args)
    {
        file = args.File;
        error = file.Size > ProductImageStore.MaxBytes ? "Ảnh banner vượt quá 5 MB." : null;
        message = null;
    }

    private void ResetImage()
    {
        file = null;
        uploadKey = Guid.NewGuid();
        form.ImageUrl = "/images/banner-harvest.svg";
        error = message = null;
    }

    private void SelectIntroImage(InputFileChangeEventArgs args)
    {
        introFile = args.File;
        error = introFile.Size > ProductImageStore.MaxBytes ? "Ảnh giới thiệu vượt quá 5 MB." : null;
        message = null;
    }

    private void ResetIntroImage()
    {
        introFile = null;
        introUploadKey = Guid.NewGuid();
        form.IntroImageUrl = "/images/showcase-farm-produce.svg";
        error = message = null;
    }

    private async Task Save()
    {
        if (busy) return;
        busy = true;
        message = error = null;
        string? uploadedBanner = null;
        string? uploadedLogo = null;
        string? uploadedIntro = null;
        var saved = false;
        var originalBannerUrl = form.ImageUrl;
        var originalLogoUrl = form.LogoUrl;
        var originalIntroUrl = form.IntroImageUrl;

        try
        {
            // 1. Upload Logo mới nếu có chọn file
            if (logoFile != null)
            {
                if (logoFile.Size > ProductImageStore.MaxBytes)
                    throw new PreOrderDomainException("Ảnh logo vượt quá 5 MB.");
                await using var logoStream = logoFile.OpenReadStream(ProductImageStore.MaxBytes);
                uploadedLogo = await Images.SaveAsync(logoStream, logoFile.Size);
                form.LogoUrl = uploadedLogo;
            }

            // 2. Upload Banner mới nếu có chọn file
            if (file != null)
            {
                if (file.Size > ProductImageStore.MaxBytes)
                    throw new PreOrderDomainException("Ảnh banner vượt quá 5 MB.");
                await using var stream = file.OpenReadStream(ProductImageStore.MaxBytes);
                uploadedBanner = await Images.SaveAsync(stream, file.Size);
                form.ImageUrl = uploadedBanner;
            }

            // 3. Upload Intro Showcase Image mới nếu có chọn file
            if (introFile != null)
            {
                if (introFile.Size > ProductImageStore.MaxBytes)
                    throw new PreOrderDomainException("Ảnh giới thiệu vượt quá 5 MB.");
                await using var introStream = introFile.OpenReadStream(ProductImageStore.MaxBytes);
                uploadedIntro = await Images.SaveAsync(introStream, introFile.Size);
                form.IntroImageUrl = uploadedIntro;
            }

            // 4. Lưu vào Database thông qua UseCase
            await Banners.SaveAsync(form);
            saved = true;

            // 5. Dọn dẹp ảnh cũ nếu có thay đổi
            if (previousBannerImage != form.ImageUrl && !previousBannerImage.StartsWith("/images/banner-harvest"))
                await Images.RemoveAsync(previousBannerImage);
            previousBannerImage = form.ImageUrl;

            if (!string.IsNullOrEmpty(previousLogoImage) && previousLogoImage != form.LogoUrl)
                await Images.RemoveAsync(previousLogoImage);
            previousLogoImage = form.LogoUrl ?? "";

            if (!string.IsNullOrEmpty(previousIntroImage) && previousIntroImage != form.IntroImageUrl && !previousIntroImage.StartsWith("/images/showcase-farm-produce"))
                await Images.RemoveAsync(previousIntroImage);
            previousIntroImage = form.IntroImageUrl ?? "";

            file = null;
            logoFile = null;
            introFile = null;
            uploadKey = Guid.NewGuid();
            logoUploadKey = Guid.NewGuid();
            introUploadKey = Guid.NewGuid();

            message = "Đã cập nhật banner, logo thương hiệu và ảnh giới thiệu trang chủ thành công!";
        }
        catch (PreOrderDomainException ex)
        {
            error = ex.Message;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Could not save home banner, logo and intro image");
            error = saved ? "Đã lưu thông tin, nhưng chưa dọn được ảnh cũ." : "Chưa lưu được giao diện. Vui lòng thử lại.";
        }
        finally
        {
            if (!saved)
            {
                form.ImageUrl = originalBannerUrl;
                form.LogoUrl = originalLogoUrl;
                form.IntroImageUrl = originalIntroUrl;
                if (uploadedBanner != null)
                {
                    try { await Images.RemoveAsync(uploadedBanner); }
                    catch (IOException ex) { Logger.LogWarning(ex, "Could not remove unused banner upload"); }
                }
                if (uploadedLogo != null)
                {
                    try { await Images.RemoveAsync(uploadedLogo); }
                    catch (IOException ex) { Logger.LogWarning(ex, "Could not remove unused logo upload"); }
                }
                if (uploadedIntro != null)
                {
                    try { await Images.RemoveAsync(uploadedIntro); }
                    catch (IOException ex) { Logger.LogWarning(ex, "Could not remove unused intro upload"); }
                }
            }
            busy = false;
        }
    }
}
