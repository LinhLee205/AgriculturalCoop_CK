@page "/admin/products"
@layout AdminLayout
@attribute [Authorize(Roles = "Admin")]
@using AgriculturalCoop.WebApp.Models
@using AgriculturalCoop.UseCases.PluginInterfaces
@using AgriculturalCoop.WebApp.Services
@inject IViewProductsUseCase ViewProducts
@inject IManageProductsUseCase ManageProducts
@inject IProductImageStore Images

<PageTitle>Nông sản - COOPAGRI</PageTitle>

<div class="page-heading">
    <div>
        <span class="eyebrow">DANH MỤC</span>
        <h1>Nông sản</h1>
        <p>Ảnh tải lên được lưu trên hệ thống.</p>
    </div>
    <button class="btn btn-success" @onclick="() => Open(null)">
        + Thêm nông sản
    </button>
</div>

@if (message != null)
{
    <div class="alert alert-success" role="status">@message</div>
}

<section class="admin-card table-responsive">
    <table class="table align-middle">
        <thead>
            <tr>
                <th>Nông sản</th>
                <th>Phân loại</th>
                <th>Giá tiêu chuẩn</th>
                <th>Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var product in products)
            {
                <tr>
                    <td>
                        <div class="d-flex gap-3 align-items-center">
                            <img class="product-thumbnail"
                                 src="@product.ImageUrl"
                                 alt="@product.ProductName"
                                 onerror="this.onerror=null;this.src='/images/products/placeholder.svg'" />
                            <div>
                                <strong>@product.ProductName</strong>
                                <small class="d-block text-muted">
                                    @product.Description
                                </small>
                            </div>
                        </div>
                    </td>
                    <td>@product.Category</td>
                    <td>@product.StandardPrice.ToString("N0") đ/@product.Unit</td>
                    <td>
                        <div class="table-actions">
                            <button class="btn btn-sm btn-outline-success"
                                    @onclick="() => Open(product)">
                                Sửa
                            </button>
                            <button class="btn btn-sm btn-outline-danger"
                                    @onclick="() => AskDelete(product)">
                                Xóa
                            </button>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    @if (products.Count == 0)
    {
        <p class="text-muted">Chưa có nông sản.</p>
    }
</section>

@if (editing)
{
    <div class="editor-backdrop">
        <section class="editor-dialog"
                 role="dialog" aria-modal="true"
                 aria-labelledby="product-title">
            <div class="d-flex justify-content-between">
                <h2 id="product-title" class="h5">
                    @(form.ProductId == 0 ? "Thêm nông sản" : "Sửa nông sản")
                </h2>
                <button class="btn-close" aria-label="Đóng"
                        disabled="@busy"
                        @onclick="() => editing = false">
                </button>
            </div>

            <EditForm Model="form" OnValidSubmit="Save">
                <DataAnnotationsValidator />

                @if (error != null)
                {
                    <div class="alert alert-danger" role="alert">@error</div>
                }

                <div class="mb-3">
                    <label class="form-label" for="product-name">Tên nông sản</label>
                    <InputText id="product-name" class="form-control"
                               @bind-Value="form.ProductName" />
                    <ValidationMessage For="@(() => form.ProductName)" />
                </div>

                <div class="row g-3">
                    <div class="col-sm-6">
                        <label class="form-label" for="product-category">Phân loại</label>
                        <InputSelect id="product-category" class="form-select"
                                     @bind-Value="form.Category">
                            <option>Trái cây đặc sản</option>
                            <option>Rau củ quả</option>
                            <option>Rau ăn lá</option>
                            <option>Dược liệu</option>
                            <option>Nông sản sạch</option>
                        </InputSelect>
                        <ValidationMessage For="@(() => form.Category)" />
                    </div>

                    <div class="col-sm-6">
                        <label class="form-label" for="product-unit">Đơn vị tính</label>
                        <InputText id="product-unit" class="form-control"
                                   @bind-Value="form.Unit" />
                        <ValidationMessage For="@(() => form.Unit)" />
                    </div>
                </div>

                <div class="my-3">
                    <label class="form-label" for="product-price">
                        Giá tiêu chuẩn (đ)
                    </label>
                    <InputNumber id="product-price" class="form-control"
                                 @bind-Value="form.StandardPrice" />
                    <ValidationMessage For="@(() => form.StandardPrice)" />
                </div>

                <div class="mb-3">
                    <label class="form-label" for="product-image">Ảnh nông sản</label>
                    <InputFile @key="uploadKey"
                               id="product-image"
                               class="form-control"
                               accept="image/png,image/jpeg,image/webp"
                               OnChange="SelectImage" />

                    <small class="d-block text-muted mt-1">
                        PNG, JPEG hoặc WebP; tối đa 5 MB.
                        @(file == null
                            ? "Giữ ảnh hiện tại nếu không chọn ảnh mới."
                            : "Đã chọn: " + file.Name)
                    </small>

                    <img class="product-preview mt-2"
                         src="@form.ImageUrl"
                         alt="Ảnh hiện tại"
                         onerror="this.onerror=null;this.src='/images/products/placeholder.svg'" />
                </div>

                <div class="mb-4">
                    <label class="form-label" for="product-description">Mô tả</label>
                    <InputTextArea id="product-description"
                                   class="form-control" rows="3"
                                   @bind-Value="form.Description" />
                    <ValidationMessage For="@(() => form.Description)" />
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <button type="button" class="btn btn-light"
                            disabled="@busy"
                            @onclick="() => editing = false">
                        Hủy
                    </button>
                    <button type="submit" class="btn btn-success" disabled="@busy">
                        Lưu nông sản
                    </button>
                </div>
            </EditForm>
        </section>
    </div>
}

@if (deleting != null)
{
    <ConfirmDelete Name="@deleting.ProductName"
                   Error="@error" Busy="busy"
                   OnCancel="() => deleting = null"
                   OnConfirm="Delete" />
}

@code {
    private List<Product> products = new();
    private ProductForm form = new();
    private Product? deleting;
    private IBrowserFile? file;
    private bool editing, busy;
    private string? error, message;
    private Guid uploadKey;

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load() =>
        products = (await ViewProducts.ExecuteAsync()).ToList();

    private void Open(Product? product)
    {
        form = product == null ? new() : ProductForm.From(product);
        file = null;
        uploadKey = Guid.NewGuid();
        editing = true;
        error = null;
    }

    private void AskDelete(Product product)
    {
        deleting = product;
        error = null;
    }

    private void SelectImage(InputFileChangeEventArgs args)
    {
        file = args.File;
        error = file.Size > ProductImageStore.MaxBytes
            ? "Ảnh vượt quá 5 MB." : null;
    }

    private async Task Save()
    {
        if (busy) return;
        busy = true;
        error = null;

        string? uploaded = null;
        var oldImage = form.ImageUrl;
        var saved = false;

        try
        {
            if (file != null)
            {
                await using var stream =
                    file.OpenReadStream(ProductImageStore.MaxBytes);

                uploaded = await Images.SaveAsync(stream, file.Size);
            }

            var product = form.ToEntity();

            if (uploaded != null)
                product.ImageUrl = uploaded;

            await ManageProducts.SaveAsync(product);
            saved = true;

            if (uploaded != null && form.ProductId > 0)
                await Images.RemoveAsync(oldImage);

            editing = false;
            message = "Đã lưu nông sản và ảnh trên hệ thống.";
            await Load();
        }
        catch (Exception ex)
            when (ex is PreOrderDomainException or IOException)
        {
            if (!saved && uploaded != null)
                await Images.RemoveAsync(uploaded);

            error = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private async Task Delete()
    {
        if (busy || deleting == null) return;
        busy = true;
        error = null;

        try
        {
            await ManageProducts.DeleteAsync(deleting.ProductId);
            await Images.RemoveAsync(deleting.ImageUrl);

            deleting = null;
            message = "Đã xóa nông sản.";
            await Load();
        }
        catch (PreOrderDomainException ex)
        {
            error = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }
}
