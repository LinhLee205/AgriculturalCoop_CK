@page "/admin/members"
@using System.ComponentModel.DataAnnotations
@inject UserSessionState UserSession
@inject IViewMembersUseCase ViewMembersUseCase
@inject IAddMemberUseCase AddMemberUseCase

<PageTitle>Quản Lý Xã Viên - HTX Nông Nghiệp</PageTitle>

@if (!UserSession.IsAdmin)
{
    <div class="alert alert-danger p-4 rounded-4 text-center my-5">
        <i class="bi bi-shield-lock-fill fs-1 text-danger mb-2 d-block"></i>
        <h4 class="fw-bold">Truy cập bị từ chối (K4.2)</h4>
        <p class="text-muted mb-3">Chỉ Ban Quản trị Hợp tác xã mới có quyền truy cập trang quản lý xã viên.</p>
        <a href="/admin" class="btn btn-warning rounded-pill px-4 fw-bold shadow-sm">
            <i class="bi bi-box-arrow-in-right me-1"></i> Đăng nhập Quản trị viên
        </a>
    </div>
}
else
{
    <div class="mb-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-1">
                        <li class="breadcrumb-item"><a href="/admin" class="text-decoration-none text-muted">Quản trị</a></li>
                        <li class="breadcrumb-item active">Xã viên</li>
                    </ol>
                </nav>
                <h2 class="fw-bold text-dark mb-0">Hồ Sơ Hộ Xã Viên Hợp Tác Xã</h2>
            </div>
            <button class="btn btn-success rounded-pill px-4 fw-semibold" @onclick="() => showAddModal = true">
                <i class="bi bi-person-plus-fill me-1"></i> Kết Nạp Xã Viên Mới
            </button>
        </div>

        @if (!string.IsNullOrEmpty(alertMsg))
        {
            <div class="alert alert-success rounded-3 py-2 px-3 mb-3">@alertMsg</div>
        }

        <div class="card border-0 rounded-4 shadow-sm bg-white overflow-hidden">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Mã</th>
                            <th>Họ và Tên</th>
                            <th>Số Điện Thoại</th>
                            <th>Địa Chỉ Vùng Trồng</th>
                            <th>Email</th>
                            <th>Diện Tích Canh Tác</th>
                            <th>Ngày Gia Nhập</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var m in members)
                        {
                            <tr>
                                <td class="fw-bold font-monospace">#@m.MemberId</td>
                                <td class="fw-bold text-dark">@m.FullName</td>
                                <td>@m.Phone</td>
                                <td>@m.Address</td>
                                <td>@m.Email</td>
                                <td><span class="badge bg-light text-dark border">@m.AreaHectare.ToString("N1") ha</span></td>
                                <td class="text-muted small">@m.JoinDate.ToString("dd/MM/yyyy")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    @if (showAddModal)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content rounded-4 border-0 shadow">
                    <div class="modal-header border-bottom">
                        <h5 class="modal-title fw-bold">Kết Nạp Xã Viên Mới</h5>
                        <button type="button" class="btn-close" @onclick="() => showAddModal = false"></button>
                    </div>
                    <EditForm Model="@newMember" OnValidSubmit="HandleAddMember">
                        <DataAnnotationsValidator />
                        <div class="modal-body p-4">
                            <div class="mb-3">
                                <label class="form-label small fw-semibold">Họ và tên <span class="text-danger">*</span></label>
                                <InputText @bind-Value="newMember.FullName" class="form-control" />
                                <ValidationMessage For="@(() => newMember.FullName)" class="validation-message" />
                            </div>
                            <div class="mb-3">
                                <label class="form-label small fw-semibold">Số điện thoại <span class="text-danger">*</span></label>
                                <InputText @bind-Value="newMember.Phone" class="form-control" />
                                <ValidationMessage For="@(() => newMember.Phone)" class="validation-message" />
                            </div>
                            <div class="mb-3">
                                <label class="form-label small fw-semibold">Địa chỉ vùng trồng <span class="text-danger">*</span></label>
                                <InputText @bind-Value="newMember.Address" class="form-control" />
                            </div>
                            <div class="row g-2 mb-3">
                                <div class="col-6">
                                    <label class="form-label small fw-semibold">Email:</label>
                                    <InputText @bind-Value="newMember.Email" class="form-control" />
                                </div>
                                <div class="col-6">
                                    <label class="form-label small fw-semibold">Diện tích (ha):</label>
                                    <InputNumber @bind-Value="newMember.AreaHectare" class="form-control" />
                                </div>
                            </div>
                        </div>
                        <div class="modal-footer border-top">
                            <button type="button" class="btn btn-light rounded-pill px-4" @onclick="() => showAddModal = false">Hủy</button>
                            <button type="submit" class="btn btn-success rounded-pill px-4 fw-bold">Lưu Hồ Sơ</button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    }
}

@code {
    private List<Member> members = new();
    private bool showAddModal = false;
    private string? alertMsg;

    public class NewMemberModel
    {
        [Required(ErrorMessage = "Họ và tên xã viên không được để trống")]
        public string FullName { get; set; } = string.Empty;

        [Required(ErrorMessage = "Số điện thoại không được để trống")]
        public string Phone { get; set; } = string.Empty;

        public string Address { get; set; } = "Thừa Thiên Huế";
        public string Email { get; set; } = string.Empty;
        public decimal AreaHectare { get; set; } = 1.5m;
    }

    private NewMemberModel newMember = new();

    protected override async Task OnInitializedAsync()
    {
        if (UserSession.IsAdmin)
        {
            await LoadMembers();
        }
    }

    private async Task LoadMembers()
    {
        members = (await ViewMembersUseCase.ExecuteAsync()).ToList();
    }

    private async Task HandleAddMember()
    {
        var member = new Member
        {
            FullName = newMember.FullName,
            Phone = newMember.Phone,
            Address = newMember.Address,
            Email = newMember.Email,
            AreaHectare = newMember.AreaHectare,
            JoinDate = DateTime.Now
        };

        await AddMemberUseCase.ExecuteAsync(member);
        showAddModal = false;
        alertMsg = $"Đã thêm xã viên {member.FullName} vào hệ thống!";
        newMember = new();
        await LoadMembers();
    }
}
