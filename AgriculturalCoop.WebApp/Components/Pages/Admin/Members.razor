@page "/admin/members"
@layout AdminLayout
@attribute [Authorize(Roles = "Admin")]
@using AgriculturalCoop.WebApp.Models
@inject IViewMembersUseCase ViewMembers
@inject IManageMembersUseCase ManageMembers

<PageTitle>Xã viên - COOPAGRI</PageTitle>

<div class="page-heading">
    <div>
        <span class="eyebrow">DANH MỤC</span>
        <h1>Xã viên</h1>
        <p>Quản lý hồ sơ và diện tích canh tác của từng hộ.</p>
    </div>
    <button class="btn btn-success" @onclick="() => Open(null)">
        + Thêm xã viên
    </button>
</div>

@if (message != null)
{
    <div class="alert alert-success" role="status">@message</div>
}

<section class="admin-card table-responsive">
    <table class="table align-middle">
        <thead>
            <tr>
                <th>Xã viên</th>
                <th>Liên hệ</th>
                <th>Địa chỉ</th>
                <th>Diện tích</th>
                <th>Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var m in members)
            {
                <tr>
                    <td>
                        <strong>@m.FullName</strong>
                        <small class="d-block text-muted">
                            XV-@m.MemberId.ToString("D3")
                        </small>
                    </td>
                    <td>
                        @m.Phone
                        <small class="d-block text-muted">@m.Email</small>
                    </td>
                    <td>@m.Address</td>
                    <td>@m.AreaHectare.ToString("N2") ha</td>
                    <td>
                        <div class="table-actions">
                            <button class="btn btn-sm btn-outline-success"
                                    @onclick="() => Open(m)">
                                Sửa
                            </button>
                            <button class="btn btn-sm btn-outline-danger"
                                    @onclick="() => AskDelete(m)">
                                Xóa
                            </button>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    @if (members.Count == 0)
    {
        <p class="text-muted">Chưa có xã viên. Hãy thêm hồ sơ đầu tiên.</p>
    }
</section>

@if (editing)
{
    <div class="editor-backdrop">
        <section class="editor-dialog"
                 role="dialog" aria-modal="true"
                 aria-labelledby="member-title">
            <div class="d-flex justify-content-between">
                <h2 id="member-title" class="h5">
                    @(form.MemberId == 0 ? "Thêm xã viên" : "Sửa xã viên")
                </h2>
                <button class="btn-close" aria-label="Đóng"
                        disabled="@busy"
                        @onclick="() => editing = false">
                </button>
            </div>

            <EditForm Model="form" OnValidSubmit="Save">
                <DataAnnotationsValidator />

                @if (error != null)
                {
                    <div class="alert alert-danger" role="alert">@error</div>
                }

                <div class="mb-3">
                    <label class="form-label" for="member-name">Họ và tên</label>
                    <InputText id="member-name" class="form-control"
                               @bind-Value="form.FullName" />
                    <ValidationMessage For="@(() => form.FullName)" />
                </div>

                <div class="row g-3">
                    <div class="col-sm-6">
                        <label class="form-label" for="member-phone">
                            Số điện thoại
                        </label>
                        <InputText id="member-phone" class="form-control"
                                   @bind-Value="form.Phone" />
                        <ValidationMessage For="@(() => form.Phone)" />
                    </div>
                    <div class="col-sm-6">
                        <label class="form-label" for="member-email">Email</label>
                        <InputText id="member-email" class="form-control"
                                   @bind-Value="form.Email" />
                        <ValidationMessage For="@(() => form.Email)" />
                    </div>
                </div>

                <div class="my-3">
                    <label class="form-label" for="member-address">Địa chỉ</label>
                    <InputText id="member-address" class="form-control"
                               @bind-Value="form.Address" />
                    <ValidationMessage For="@(() => form.Address)" />
                </div>

                <div class="mb-4">
                    <label class="form-label" for="member-area">Diện tích (ha)</label>
                    <InputNumber id="member-area" class="form-control"
                                 @bind-Value="form.AreaHectare" />
                    <ValidationMessage For="@(() => form.AreaHectare)" />
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <button type="button" class="btn btn-light"
                            disabled="@busy"
                            @onclick="() => editing = false">
                        Hủy
                    </button>
                    <button type="submit" class="btn btn-success" disabled="@busy">
                        Lưu xã viên
                    </button>
                </div>
            </EditForm>
        </section>
    </div>
}

@if (deleting != null)
{
    <ConfirmDelete Name="@deleting.FullName"
                   Error="@error" Busy="busy"
                   OnCancel="() => deleting = null"
                   OnConfirm="Delete" />
}

@code {
    private List<Member> members = new();
    private MemberForm form = new();
    private Member? deleting;
    private bool editing, busy;
    private string? error, message;

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load() =>
        members = (await ViewMembers.ExecuteAsync()).ToList();

    private void Open(Member? member)
    {
        form = member == null ? new() : MemberForm.From(member);
        editing = true;
        error = null;
    }

    private void AskDelete(Member member)
    {
        deleting = member;
        error = null;
    }

    private async Task Save()
    {
        if (busy) return;
        busy = true;
        error = null;

        try
        {
            await ManageMembers.SaveAsync(form.ToEntity());
            editing = false;
            message = "Đã lưu hồ sơ xã viên.";
            await Load();
        }
        catch (PreOrderDomainException ex)
        {
            error = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private async Task Delete()
    {
        if (busy || deleting == null) return;
        busy = true;
        error = null;

        try
        {
            await ManageMembers.DeleteAsync(deleting.MemberId);
            deleting = null;
            message = "Đã xóa xã viên.";
            await Load();
        }
        catch (PreOrderDomainException ex)
        {
            error = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }
}
