@page "/admin/orders"
@layout AdminLayout
@attribute [Authorize(Roles = "Admin")]
@inject IViewAllPreOrdersUseCase ViewOrders
<PageTitle>Quản lý đơn đặt trước — COOPAGRI</PageTitle>
<div class="page-heading"><div><span class="eyebrow">MÙA VỤ & GIAO DỊCH</span><h1>Đơn đặt trước</h1><p>Xem chi tiết, xác nhận đơn đang chờ và hủy đơn chưa phân bổ. Đơn đã giao dịch được giữ để đối chiếu.</p></div><a href="/admin/dealers" class="btn btn-outline-success">Quản lý đại lý</a></div>
<section class="admin-card mb-4"><div class="row g-3"><div class="col-md-7"><label for="order-search" class="form-label">Tìm mã đơn, đại lý hoặc mã lô</label><input id="order-search" class="form-control" @bind="search" @bind:event="oninput" /></div><div class="col-md-5"><label for="order-status" class="form-label">Trạng thái</label><select id="order-status" class="form-select" @bind="status"><option value="">Tất cả</option><option value="0">Chờ xác nhận</option><option value="1">Đã xác nhận</option><option value="2">Phân bổ một phần</option><option value="3">Đã phân bổ đủ</option><option value="4">Đã hủy</option></select></div></div>
@if (DealerId.HasValue || BatchId.HasValue) { <p class="small mt-3 mb-0">Đang lọc theo @(DealerId.HasValue ? "đại lý #" + DealerId : "lô #" + BatchId). <a href="/admin/orders">Bỏ lọc liên kết</a></p> }</section>
@if (loading) { <p role="status">Đang tải đơn…</p> }
else
{
    <section class="admin-card table-responsive"><table class="table align-middle"><thead><tr><th>Mã đơn / ngày đặt</th><th>Đại lý</th><th>Số lô</th><th>Giá trị đặt</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody>
    @foreach (var o in Filtered) { <tr><td><a href="/admin/orders/@o.PreOrderId" class="fw-bold">@o.OrderNumber</a><small class="d-block text-muted">@o.OrderDate.ToString("dd/MM/yyyy HH:mm")</small></td><td>@o.Dealer?.DealerName<small class="d-block text-muted">@o.ContactPhone</small></td><td>@o.PreOrderLines.Select(l => l.HarvestBatchId).Distinct().Count()</td><td>@o.TotalAmount.ToString("N0") đ</td><td><OrderStatusBadge Status="o.Status" /></td><td><a class="btn btn-sm btn-outline-success" href="/admin/orders/@o.PreOrderId">Chi tiết / xử lý</a></td></tr> }
    </tbody></table>@if (!Filtered.Any()) { <p class="text-muted">Không có đơn phù hợp.</p> }</section>
}
@code {
    [SupplyParameterFromQuery(Name = "dealerId")] public int? DealerId { get; set; }
    [SupplyParameterFromQuery(Name = "batchId")] public int? BatchId { get; set; }
    private List<PreOrder> orders = new();
    private string search = "", status = "";
    private bool loading = true;
    private IEnumerable<PreOrder> Filtered => orders.Where(o => (!DealerId.HasValue || o.DealerId == DealerId) &&
        (!BatchId.HasValue || o.PreOrderLines.Any(l => l.HarvestBatchId == BatchId)) && (status.Length == 0 || ((int)o.Status).ToString() == status) &&
        (search.Trim().Length == 0 || o.OrderNumber.Contains(search.Trim(), StringComparison.OrdinalIgnoreCase) ||
        (o.Dealer?.DealerName.Contains(search.Trim(), StringComparison.OrdinalIgnoreCase) ?? false) ||
        o.PreOrderLines.Any(l => l.HarvestBatch?.BatchCode.Contains(search.Trim(), StringComparison.OrdinalIgnoreCase) ?? false)));
    protected override async Task OnInitializedAsync() { orders = (await ViewOrders.ExecuteAsync()).ToList(); loading = false; }
}
