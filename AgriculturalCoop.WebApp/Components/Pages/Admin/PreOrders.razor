@page "/admin/orders"
@inject UserSessionState UserSession
@inject IViewAllPreOrdersUseCase ViewAllPreOrdersUseCase

<PageTitle>Quản Lý Đơn Đặt Trước - Admin HTX</PageTitle>

@if (!UserSession.IsAdmin)
{
    <div class="alert alert-danger p-4 rounded-4 text-center my-5">
        <i class="bi bi-shield-lock-fill fs-1 text-danger mb-2 d-block"></i>
        <h4 class="fw-bold">Truy cập bị từ chối (K4.2)</h4>
        <p class="text-muted">Chỉ Ban Quản trị Hợp tác xã mới có quyền xem danh sách toàn bộ đơn đặt trước.</p>
    </div>
}
else
{
    <div class="mb-4">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1">
                <li class="breadcrumb-item"><a href="/admin" class="text-decoration-none text-muted">Quản trị</a></li>
                <li class="breadcrumb-item active">Đơn đặt trước</li>
            </ol>
        </nav>
        <h2 class="fw-bold text-dark mb-4">Danh Sách Toàn Bộ Đơn Đặt Trước Sỉ</h2>

        @if (loading)
        {
            <div class="text-center py-5">
                <div class="spinner-border text-success" role="status"></div>
                <p class="text-muted mt-2">Đang nạp dữ liệu đơn đặt...</p>
            </div>
        }
        else if (!orders.Any())
        {
            <div class="card border-0 rounded-4 shadow-sm p-5 text-center bg-white">
                <p class="text-muted mb-0">Chưa có đơn đặt trước nào trong hệ thống.</p>
            </div>
        }
        else
        {
            <div class="card border-0 rounded-4 shadow-sm bg-white overflow-hidden">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Mã Đơn</th>
                                <th>Đại Lý Đặt Hàng</th>
                                <th>Ngày Đặt</th>
                                <th>Số Mặt Hàng</th>
                                <th>Tổng Tiền</th>
                                <th>Trạng Thái</th>
                                <th>Ghi Chú</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var o in orders)
                            {
                                <tr>
                                    <td class="fw-bold font-monospace text-dark">@o.OrderNumber</td>
                                    <td>
                                        <div class="fw-semibold text-dark">@(o.Dealer?.DealerName ?? $"Đại lý #{o.DealerId}")</div>
                                        <small class="text-muted">@o.Dealer?.Phone</small>
                                    </td>
                                    <td class="text-muted small">@o.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td><span class="badge bg-light text-dark border">@o.PreOrderLines.Count dòng</span></td>
                                    <td class="fw-bold text-success">@o.TotalAmount.ToString("N0") VNĐ</td>
                                    <td>
                                        @if (o.Status == PreOrderStatus.Confirmed)
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1">Đã xác nhận</span>
                                        }
                                        else if (o.Status == PreOrderStatus.PartiallyAllocated || o.Status == PreOrderStatus.FullyAllocated)
                                        {
                                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-3 py-1">Đã phân bổ</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary rounded-pill px-3 py-1">@o.Status</span>
                                        }
                                    </td>
                                    <td class="text-muted small">@o.Notes</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </div>
}

@code {
    private List<PreOrder> orders = new();
    private bool loading = true;

    protected override async Task OnInitializedAsync()
    {
        if (UserSession.IsAdmin)
        {
            orders = (await ViewAllPreOrdersUseCase.ExecuteAsync()).ToList();
            loading = false;
        }
    }
}
