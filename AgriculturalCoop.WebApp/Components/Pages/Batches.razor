@inject UserSessionState UserSession
@page "/batches"
@inject IViewOpenBatchesUseCase ViewHarvestBatchesUseCase
@inject IPreOrderCart Cart
@inject NavigationManager Nav

<PageTitle>Danh Mục Lô Nông Sản Thu Hoạch — COOPAGRI</PageTitle>

<div class="mb-4">
    <div class="page-heading">
        <div>
            <span class="eyebrow">MÙA VỤ THU HOẠCH</span>
            <h1>Lô nông sản chuẩn bị thu hoạch</h1>
            <p>Theo dõi tiến độ mùa vụ từng hộ xã viên và đặt trước sản lượng thực tế.</p>
        </div>
        <a href="/products" class="btn btn-outline-success rounded-pill px-3">
            <i class="bi bi-grid me-1"></i> Xem toàn bộ nông sản
        </a>
    </div>

    <!-- Khung bộ lọc lô mùa vụ với nền xanh lá nhạt và button bo tròn dạng pill -->
    <section class="admin-card mb-4 product-filter-box" aria-label="Bộ lọc lô mùa vụ">
        <div class="row align-items-center g-3 mb-3">
            <div class="col-md-7">
                <SearchBar @bind-SearchTerm="searchTerm" OnSearch="ApplyFilter" />
            </div>
            <div class="col-md-5 text-md-end">
                <span class="small text-muted">
                    <i class="bi bi-info-circle me-1"></i>Chỉ hiển thị các <strong>lô thu hoạch</strong> đang mở đặt
                </span>
            </div>
        </div>

        <!-- Category Filter Chips bo tròn trên nền xanh lá nhạt -->
        <div class="d-flex flex-wrap align-items-center gap-2 pt-2 border-top border-success-subtle">
            <span class="small text-muted fw-semibold me-1">
                <i class="bi bi-funnel me-1"></i>Danh mục:
            </span>
            <button class="btn btn-sm rounded-pill px-3 py-1-5 transition-all @(selectedCategory == "All" ? "btn-success shadow-sm" : "btn-filter-chip")" 
                    @onclick="@(() => SelectCategory("All"))">
                Tất cả (@allBatches.Count)
            </button>
            @foreach (var category in Categories)
            {
                var count = allBatches.Count(b => b.Product?.Category == category);
                <button class="btn btn-sm rounded-pill px-3 py-1-5 transition-all @(selectedCategory == category ? "btn-success shadow-sm" : "btn-filter-chip")"
                        @onclick="@(() => SelectCategory(category))">
                    @category (@count)
                </button>
            }
        </div>
    </section>

    @if (loading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-success" role="status"></div>
            <p class="text-muted mt-2">Đang tải danh sách lô mùa vụ...</p>
        </div>
    }
    else if (!filteredBatches.Any())
    {
        <div class="card border-0 rounded-4 shadow-sm p-5 text-center bg-white">
            <i class="bi bi-search text-muted fs-1 mb-3"></i>
            <h5 class="fw-bold text-dark">Không tìm thấy lô nông sản phù hợp</h5>
            <p class="text-muted small">Vui lòng thử tìm kiếm với từ khóa hoặc danh mục khác.</p>
        </div>
    }
    else
    {
        <p class="small text-muted mb-3">
            <i class="bi bi-check2-circle text-success me-1"></i>
            Hiển thị <strong>@filteredBatches.Count</strong> lô mùa vụ đang tiếp nhận đơn đặt trước.
        </p>
        <div class="catalog-grid">
            @foreach (var batch in filteredBatches)
            {
                <div>
                    <HarvestBatchCard Batch="batch" OnOrderClick="HandleOrderClick" />
                </div>
            }
        </div>
    }
</div>

@code {
    private List<HarvestBatch> allBatches = new();
    private List<HarvestBatch> filteredBatches = new();
    private string searchTerm = string.Empty;
    private string selectedCategory = "All";
    private bool loading = true;
    private IEnumerable<string> Categories => allBatches.Select(b => b.Product?.Category)
        .Where(c => !string.IsNullOrWhiteSpace(c)).Select(c => c!).Distinct().OrderBy(c => c);

    protected override async Task OnInitializedAsync()
    {
        var batches = await ViewHarvestBatchesUseCase.ExecuteAsync();
        allBatches = batches.OrderBy(b => b.ExpectedHarvestDate).ToList();
        filteredBatches = allBatches;
        loading = false;
    }

    private void SelectCategory(string category)
    {
        selectedCategory = category;
        ApplyFilter();
    }

    private void ApplyFilter()
    {
        filteredBatches = allBatches.Where(b =>
        {
            bool matchCat = selectedCategory == "All" || (b.Product?.Category?.Equals(selectedCategory, StringComparison.OrdinalIgnoreCase) ?? false);
            bool matchSearch = string.IsNullOrWhiteSpace(searchTerm) ||
                               (b.BatchCode.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)) ||
                               (b.Product?.ProductName?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ?? false) ||
                               (b.Member?.FullName?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ?? false);
            return matchCat && matchSearch;
        }).ToList();
    }

    private async Task HandleOrderClick(HarvestBatch batch)
    {
        await UserSession.InitializeAsync();

        if (!UserSession.IsDealer)
        {
            Nav.NavigateTo("/batches/" + batch.HarvestBatchId);
            return;
        }

        Nav.NavigateTo("/batches/" + batch.HarvestBatchId);
    }
}
