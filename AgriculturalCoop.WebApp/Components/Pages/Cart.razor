@page "/cart"
@page "/checkout"
@attribute [Authorize(Roles = "Dealer")]
@using AgriculturalCoop.WebApp.Models
@implements IDisposable
@inject IPreOrderCart CartState
@inject ICreatePreOrderUseCase CreateOrder
@inject IValidatePreOrderUseCase ValidateOrder
@inject UserSessionState UserSession
@inject NavigationManager Nav
@inject ILogger<Cart> Logger

<PageTitle>Xác nhận đặt trước — COOPAGRI</PageTitle>
<div class="page-heading"><div><span class="eyebrow">GIỎ ĐẶT TRƯỚC</span><h1>Kiểm tra và xác nhận đơn</h1><p>Điền thông tin nhận hàng trước khi gửi đơn cho hợp tác xã.</p></div><a href="/batches" class="btn btn-outline-success">Chọn thêm lô</a></div>
@if (error != null) { <div class="alert alert-danger" role="alert">@error</div> }
@if (CartState.TotalItemCount == 0)
{
    <div class="store-empty">Giỏ đặt trước hiện đang trống. <a href="/batches">Khám phá các lô đang mở đặt →</a></div>
}
else
{
    <div class="row g-4">
        <section class="col-lg-7" aria-label="Các lô đã chọn">
            @foreach (var item in CartState.Items)
            {
                <PreOrderLineItemComponent @key="item.HarvestBatchId" Item="item" OnRemove="Remove" OnQuantityChanged="ChangeQuantity" />
            }
            <button class="btn btn-outline-danger btn-sm" disabled="@busy" @onclick="CartState.Clear">Xóa toàn bộ giỏ</button>
        </section>
        <section class="col-lg-5">
            <div class="admin-card">
                <h2 class="h5 mb-3">Thông tin nhận hàng</h2>
                <EditForm Model="contact" OnValidSubmit="Submit" FormName="order-checkout">
                    <DataAnnotationsValidator />
                    <fieldset disabled="@busy">
                        <div class="mb-3"><label for="checkout-recipient" class="form-label">Tên người nhận <span class="text-danger">*</span></label><InputText id="checkout-recipient" class="form-control" @bind-Value="contact.RecipientName" maxlength="150" autocomplete="name" /><ValidationMessage For="() => contact.RecipientName" /></div>
                        <div class="mb-3"><label for="checkout-phone" class="form-label">Số điện thoại <span class="text-danger">*</span></label><InputText id="checkout-phone" class="form-control" @bind-Value="contact.ContactPhone" maxlength="20" type="tel" autocomplete="tel" /><ValidationMessage For="() => contact.ContactPhone" /></div>
                        <div class="mb-3"><label for="checkout-address" class="form-label">Địa chỉ nhận hàng <span class="text-danger">*</span></label><InputTextArea id="checkout-address" class="form-control" @bind-Value="contact.DeliveryAddress" maxlength="255" rows="3" autocomplete="street-address" placeholder="Số nhà, đường, phường/xã, tỉnh/thành phố" /><ValidationMessage For="() => contact.DeliveryAddress" /></div>
                        <div class="mb-3"><label for="checkout-notes" class="form-label">Ghi chú cho hợp tác xã</label><InputTextArea id="checkout-notes" class="form-control" @bind-Value="contact.Notes" maxlength="500" rows="2" /><ValidationMessage For="() => contact.Notes" /></div>
                        <hr />
                        <p class="small text-muted">Đại lý: <strong>@UserSession.CurrentDealerName</strong> · @CartState.TotalItemCount lô</p>
                        <div class="d-flex justify-content-between gap-3 mb-3"><strong>Tổng tiền dự kiến</strong><strong class="fs-4 text-success">@total.ToString("N0") đ</strong></div>
                        <p class="small text-muted">Khi hụt mùa, lượng nhận thực tế theo kết quả phân bổ của hợp tác xã. Đơn chỉ được tạo khi bạn bấm xác nhận bên dưới.</p>
                        <button type="submit" class="btn btn-success w-100" disabled="@busy">@(busy ? "Đang gửi đơn…" : "Xác nhận thông tin và đặt trước")</button>
                    </fieldset>
                </EditForm>
            </div>
        </section>
    </div>
}
@code {
    private CheckoutContactForm contact = new();
    private decimal total;
    private bool busy;
    private string? error;
    protected override async Task OnInitializedAsync()
    {
        await UserSession.InitializeAsync();
        CartState.OnChange += CartChanged;
        total = CartState.TotalAmount;
        if (CartState.TotalItemCount > 0)
        {
            try { var preview = BuildOrder(); await ValidateOrder.ValidateAsync(preview); total = preview.TotalAmount; }
            catch (PreOrderDomainException ex) { error = ex.Message; }
        }
    }
    private void CartChanged() { total = CartState.TotalAmount; StateHasChanged(); }
    private void Remove(int batchId) { if (!busy) CartState.RemoveItem(batchId); }
    private void ChangeQuantity((int BatchId, decimal NewQty) args) { if (!busy) CartState.UpdateQuantity(args.BatchId, args.NewQty); }
    private PreOrder BuildOrder() => new()
    {
        DealerId = UserSession.CurrentDealerId,
        RecipientName = contact.RecipientName, ContactPhone = contact.ContactPhone,
        DeliveryAddress = contact.DeliveryAddress, Notes = contact.Notes,
        PreOrderLines = CartState.Items.Select(i => new PreOrderLine { HarvestBatchId = i.HarvestBatchId, Quantity = i.Quantity }).ToList()
    };
    private async Task Submit()
    {
        if (busy) return;
        busy = true; error = null;
        try
        {
            await UserSession.InitializeAsync();
            if (!UserSession.IsDealer) throw new PreOrderDomainException("Vui lòng đăng nhập tài khoản đại lý để xác nhận đơn.");
            var order = BuildOrder();
            await ValidateOrder.ValidateAsync(order);
            if (order.TotalAmount != total)
            {
                total = order.TotalAmount;
                error = "Giá đã thay đổi. Vui lòng kiểm tra tổng tiền mới và xác nhận lại.";
                return;
            }
            await CreateOrder.ExecuteAsync(order);
            CartState.Clear();
            Nav.NavigateTo("/my-orders");
        }
        catch (PreOrderDomainException ex) { error = ex.Message; }
        catch (Exception ex) { Logger.LogError(ex, "Could not submit checkout"); error = "Chưa xác nhận được đơn. Vui lòng kiểm tra lịch sử đơn trước khi thử lại."; }
        finally { busy = false; }
    }
    public void Dispose() => CartState.OnChange -= CartChanged;
}
