@inject IPreOrderCart Cart
@implements IDisposable
<nav class="store-navbar" aria-label="Điều hướng cửa hàng">
    <div class="store-navbar-inner">
        <a class="store-brand" href="/" aria-label="COOPAGRI — Trang chủ">🌿 COOP<span>AGRI</span></a>
        <button type="button" class="mobile-menu-button" aria-label="Mở menu" aria-expanded="@menuOpen" @onclick="() => menuOpen = !menuOpen">☰</button>
        <div class="store-navigation @(menuOpen ? "is-open" : "")">
            <div class="store-menu-links">
                <NavLink href="/" Match="NavLinkMatch.All">Trang chủ</NavLink>
                <NavLink href="/products">Nông sản</NavLink>
                <NavLink href="/batches">Lô mùa vụ</NavLink>
            </div>
        </div>
        <div class="store-account-tools">
            <AuthorizeView Roles="Dealer">
                <a href="/cart" class="header-cart" aria-label="Giỏ đặt trước"><i class="bi bi-bag" aria-hidden="true"></i>@if (Cart.TotalItemCount > 0) { <span>@Cart.TotalItemCount</span> }</a>
            </AuthorizeView>
            <CustomerAccountMenu />
        </div>
    </div>
</nav>
@code {
    private bool menuOpen;
    protected override void OnInitialized() => Cart.OnChange += RefreshCart;
    private void RefreshCart() => _ = InvokeAsync(StateHasChanged);
    public void Dispose() => Cart.OnChange -= RefreshCart;
}
