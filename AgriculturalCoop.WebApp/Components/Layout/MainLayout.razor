@inherits LayoutComponentBase
@inject UserSessionState UserSession

<div class="store-shell">
    <TopNavBar />
    <main class="store-main">@Body</main>
    <footer class="store-footer">
        <div><a class="footer-brand" href="/">🌿 COOP<span>AGRI</span></a><p>Kết nối người trồng. Trao gửi mùa tươi.</p></div>
        <span>© @DateTime.Now.Year COOPAGRI · Nông sản theo mùa</span>
    </footer>
</div>
<div id="blazor-error-ui" style="display:none">
    Kết nối bị gián đoạn. <a href="">Tải lại trang</a>
</div>
@code {
    protected override async Task OnInitializedAsync() => await UserSession.InitializeAsync();
}
