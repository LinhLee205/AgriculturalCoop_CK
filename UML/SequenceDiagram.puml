@startuml SequenceDiagram
autonumber
actor "Đại lý (Dealer)" as Dealer
boundary "Cart.razor (/checkout)" as UI
control "CreatePreOrderUseCase" as UseCase
database "IHarvestBatchRepository" as BatchRepo
database "IPreOrderRepository" as OrderRepo
database "SQL Server (Transaction)" as DB

== Giai đoạn 1: Đặt trước & Kiểm tra Luật 1 ==
Dealer -> UI : Kiểm tra lô, số lượng; nhập người nhận, điện thoại, địa chỉ
UI -> UseCase : ExecuteAsync(preOrder)

UseCase -> BatchRepo : GetBatchByIdAsync(batchId)
BatchRepo --> UseCase : Trả về HarvestBatch (ExpectedQuantity)

UseCase -> OrderRepo : GetTotalOrderedQuantityForBatchAsync(batchId)
OrderRepo --> UseCase : Trả về CurrentOrderedQuantity

alt currentOrdered + requested > ExpectedQuantity (Vi phạm Luật 1)
    UseCase --> UI : Ném ExceededExpectedYieldException
    UI --> Dealer : Hiển thị lỗi: "Vượt quá sản lượng dự kiến còn lại của lô"
else Hợp lệ (Tổng đặt <= ExpectedQuantity)
    UseCase -> OrderRepo : CreatePreOrderTransactionAsync(preOrder)
    OrderRepo -> DB : BEGIN TRANSACTION
    OrderRepo -> DB : INSERT INTO PreOrders (Header)
    OrderRepo -> DB : INSERT INTO PreOrderLines (Lines)
    OrderRepo -> DB : COMMIT
    DB --> OrderRepo : Thành công (PreOrderId)
    OrderRepo --> UseCase : Trả về PreOrderId
    UseCase --> UI : Thành công
    UI --> Dealer : Thông báo đặt trước thành công trong 1 Transaction!
end

== Giai đoạn 2: Thu hoạch thực tế & Chạy Phân bổ Luật 2 ==
actor "Ban Quản trị HTX" as Admin
boundary "AllocationManager.razor" as AdminUI
control "AllocateHarvestUseCase" as AllocUseCase
entity "AllocationService" as AllocService
database "IAllocationRepository" as AllocRepo

Admin -> AdminUI : Nhập sản lượng thực tế (ActualQuantity) & bấm "Chạy phân bổ"
AdminUI -> AllocUseCase : ExecuteAsync(batchId, actualQuantity)

AllocUseCase -> OrderRepo : GetLinesByBatchIdAsync(batchId)
OrderRepo --> AllocUseCase : Danh sách PreOrderLines

AllocUseCase -> AllocService : CalculateAllocation(batch, lines, actualQuantity)
note right of AllocService
  Áp dụng công thức Tỷ lệ:
  Allocated = (Line.Quantity / TotalRequested) * ActualQuantity
  Kết hợp Largest Remainder:
  Tổng phân bổ == min(ActualQuantity, TotalRequested)
end note
AllocService --> AllocUseCase : Trả về List<AllocationResultItem>

AllocUseCase -> AllocRepo : SaveAllocationsTransactionAsync(batchId, allocations, actual, date, notices)
AllocRepo -> DB : BEGIN TRANSACTION
AllocRepo -> DB : DELETE FROM Allocations WHERE BatchId = @BatchId
AllocRepo -> DB : INSERT INTO Allocations (Từng đại lý)
AllocRepo -> DB : UPDATE HarvestBatches SET Status = Allocated
AllocRepo -> DB : Lưu / cập nhật DealerNotifications theo mẫu
AllocRepo -> DB : COMMIT

DB --> AllocRepo : Thành công
AllocRepo --> AllocUseCase : Hoàn tất
AllocUseCase --> AdminUI : Hiển thị bảng phân bổ từng đại lý (Khớp 100%)

== Giai đoạn 3: Đại lý kiểm tra số lượng thực tế nhận được ==
boundary "MyNotifications.razor" as InboxUI
control "DealerNotificationUseCases" as InboxUseCase
database "IDealerNotificationRepository" as NoticeRepo
Dealer -> InboxUI : Mở thông báo trên web
InboxUI -> InboxUseCase : ListAsync()
InboxUseCase -> NoticeRepo : GetByDealerAsync(id từ phiên đã xác thực)
NoticeRepo -> DB : SELECT thông báo của đúng đại lý
DB --> NoticeRepo : Thông báo kết quả phân bổ
NoticeRepo --> InboxUseCase : Danh sách
InboxUseCase --> InboxUI : Hiển thị số lượng chính xác đến 0,01 kg

== Giai đoạn 4: Nội dung bổ sung cần admin duyệt ==
control "GenerateAllocationNoticeUseCase" as Draft
control "ComposeAllocationNoticeWordingUseCase" as AiWording
participant "IChatClient" as Chat
control "PublishAllocationNoticeUseCase" as Publish
Admin -> AdminUI : Chọn AI soạn bản nháp
AdminUI -> Draft : ExecuteAsync(..., useAi=true)
Draft -> AiWording : WriteAsync(facts)
AiWording -> Chat : GetResponseAsync(...)
Chat --> AiWording : JSON lời văn / lỗi dịch vụ
AiWording --> Draft : Lời văn hợp lệ / thông báo lỗi thân thiện
Draft --> AdminUI : Bản nháp chưa ghi CSDL
Admin -> AdminUI : Kiểm tra, chỉnh sửa và duyệt
AdminUI -> Publish : ExecuteAsync(draft, approved=true)
Publish -> Publish : Kiểm tra quyền Admin và dữ liệu còn khớp
Publish -> NoticeRepo : SaveReviewedAsync(notification)
NoticeRepo -> DB : Lưu nội dung đã duyệt vào hộp thông báo
@enduml
